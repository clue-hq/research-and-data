# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
*.egg

# Virtualenvs / uv
.venv/
venv/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.firecrawl/

# Editors / OS
.DS_Store
.idea/
# Ignore personal editor state, but track the shared workspace settings (VS Code / Cursor) — they
# protect the hand-authored docs from format-on-save corruption and align Python formatting with ruff.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Local env / secrets — never commit (M0.4 owns secrets handling)
.env
.env.*
!.env.example

# Browser-tool artifacts (Playwright MCP console/page logs)
.playwright-mcp/
.gstack/

# Design-API runtime byproduct (asset blobs written during live editor browser sessions)
.artifacts/

# Worktree-local services, agent workspaces, logs, and process records.
.runtime/

# Founder ruling 2026-08-30: .context (session artifacts, sample-run evidence) is tracked.
# Conductor may re-add ".context/" to .git/info/exclude; this negation keeps it tracked anyway.
!.context/

# SDD ledgers, review packages and research scratch (never committed; durable copies go under docs/superpowers/)
# gstack/superpowers scratch (brainstorm mockups, SDD ledgers)
.superpowers/

# Session recordings and transcripts never enter git (founder, 2026-09-21)
.context/attachments/**/*.mov
.context/attachments/**/*.mp4
.context/attachments/**/Transcript*
