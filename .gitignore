# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
*.egg

# Virtualenvs / uv
.venv/
venv/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.firecrawl/

# Editors / OS
.DS_Store
.idea/
# Ignore personal editor state, but track the shared workspace settings (VS Code / Cursor) — they
# protect the hand-authored docs from format-on-save corruption and align Python formatting with ruff.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Local env / secrets — never commit (M0.4 owns secrets handling)
.env
.env.*
!.env.example

# Browser-tool artifacts (Playwright MCP console/page logs)
.playwright-mcp/
.gstack/

# Design-API runtime byproduct (asset blobs written during live editor browser sessions)
.artifacts/

# gstack/superpowers scratch (brainstorm mockups, SDD ledgers)
.superpowers/
