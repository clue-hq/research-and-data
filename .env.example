# Clue-HQ Research & Data subsystem — environment variables (M0.4 / ENG-120).
#
# Copy to `.env` and fill in real values for LOCAL DEV ONLY. `.env` is git-ignored
# (see .gitignore) and MUST NEVER be committed. This file documents the variable NAMES
# with placeholders ONLY — it holds no real secrets.
#
# Platform secret values are read once via `clue_research.config.Secrets` (pydantic-settings
# BaseSettings, env_prefix=CLUE_) and injected; nothing reads os.environ ad hoc. Non-secret platform
# deploy knobs (e.g. CLUE_SYNTHESIS_MODEL) are read via `clue_research.config.Settings` /
# `load_settings()`. The embedded design service retains its established LUMEN_/OPENROUTER_ names
# through `py_lumen_config`; its deployment variables are called out explicitly below.
# Platform secrets remain wrapped in pydantic `SecretStr` and are redacted before logs/traces.

# --- Database (shared seam) -------------------------------------------------
# The Postgres DSN. OWNED/documented by M0.4 (config/); the db/ package (M0.3) reads the SAME
# variable. This is the one spelling of the DB DSN env var across the whole subsystem.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
CLUE_DATABASE_URL=postgresql+asyncpg://clue:CHANGEME@localhost:5432/clue
# Per-process database connection pool (SQLAlchemy). Defaults are the library's.
CLUE_DB_POOL_SIZE=5
CLUE_DB_MAX_OVERFLOW=10
CLUE_DB_POOL_TIMEOUT_S=30

# --- Durable artifact storage (shared by API + every worker) -----------------
# Local full-stack processes that share CLUE_DATABASE_URL MUST also use the same explicit,
# persistent storage root. Do not pair a long-lived/reused database with a disposable /tmp root:
# Postgres retains the content address but cannot reconstruct missing message bytes. Prefer an
# absolute path so API and worker cannot interpret a relative root from different directories.
# Recommended: the absolute path of THIS checkout's .artifacts/ — each worktree's .env then names
# its own repo-local store. Never leave it unset: a process without it falls back silently (the
# design API's standalone default is /private/tmp/lumen-dev-storage), and bytes written under one
# root are invisible to every process reading another (lived 2026-08-29: cloned-section rows in
# Postgres, payload bytes stranded in the fallback root after a restart).
CLUE_STORAGE_BACKEND=fs
CLUE_STORAGE_FS_ROOT=/absolute/path/to/your/checkout/.artifacts
# Production should use one shared S3-compatible backend (or a proven shared persistent volume),
# never container-local ephemeral files. Bucket/endpoint/region are non-secret; credentials are
# secrets and remain empty in this example.
CLUE_STORAGE_S3_BUCKET=
CLUE_STORAGE_S3_ENDPOINT_URL=
CLUE_STORAGE_S3_REGION=
CLUE_STORAGE_S3_ACCESS_KEY_ID=
CLUE_STORAGE_S3_SECRET_ACCESS_KEY=
# Keep-alive connections the process-wide shared S3/R2 client may hold.
CLUE_STORAGE_S3_MAX_POOL_CONNECTIONS=50

# --- Redis (in-flight locks + rate-limit coordination — M2.4) ---------------
# The Redis DSN. The shared seam read by clue_research.locks (NOT a source of truth — Postgres is;
# Redis holds ephemeral lock/rate-limit state only, conventions §6). The lock tests skip gracefully
# when this is unset / unreachable. Format: redis://[:PASSWORD@]HOST:PORT/DB
CLUE_REDIS_URL=redis://localhost:6379/0

# --- Provider API keys (resolvers — M4) -------------------------------------
# Each provider is "just a resolver" behind the Resolver protocol; the key is read here, not in
# the caller, so a Clay -> direct-API swap changes which key is read, not any downstream code.
# Leave any unused provider unset (the field defaults to None; M0 ships no live integration).
CLUE_CLAY_API_KEY=
CLUE_APOLLO_API_KEY=
CLUE_ZOOMINFO_API_KEY=
CLUE_BUILTWITH_API_KEY=
CLUE_DUNS_API_KEY=
CLUE_EXA_API_KEY=
CLUE_EXA_WEBSETS_WEBHOOK_SECRET=
CLUE_EXA_WEBSETS_LIFECYCLE_ENABLED=true
CLUE_EXA_WEBSETS_ACQUISITION_ENABLED=true
CLUE_EXA_TARGETED_ENRICHMENT_ENABLED=true
# ARV2 AI Ark (people/company enrichment) — sent as the X-TOKEN header; the ARV2 raw sink
# redacts it before any raw record is written.
CLUE_AI_ARK_API_KEY=
# Legacy Gemini transcription credential; current recording tools use Deepgram below.
CLUE_GEMINI_API_KEY=
# Recording ASR uses the same trial credential; CLUE_ takes precedence when both are set.
CLUE_DEEPGRAM_API_KEY=
DEEPGRAM_API_KEY=
# en (trial baseline), auto (dominant language), or multi (code-switching).
CLUE_ARV2_DEEPGRAM_LANGUAGE=en
# Nova-3 prerecorded PAYG USD/minute (diarization included); estimates, not invoice charges.
# https://deepgram.com/pricing — checked 2026-09-26. Override for negotiated rates.
CLUE_ARV2_DEEPGRAM_USD_PER_MINUTE=0.0043
CLUE_ARV2_DEEPGRAM_MULTI_USD_PER_MINUTE=0.0052
# M8C C6: selected-contact Exa Search is independently authorized from account profiling.
CLUE_EXA_CONTACT_DEEP_ACQUISITION_ENABLED=true
# C5 channel acquisition additionally requires an accepted validator-backed production binding.
CLUE_CONTACT_CHANNEL_ENRICHMENT_ENABLED=false
# FI-2 Slice 10: authenticated Contacts-table email lookup, on AI Ark's single-person export (the
# research agents' email path; founder ruling 2026-09-29). Separate from C5 validated delivery.
CLUE_FRONTEND_CONTACT_EMAIL_LOOKUP_ENABLED=true
CLUE_FRONTEND_CONTACT_EMAIL_POLL_AFTER_S=5
# Provider-neutral re-offer cadence for committee/contact external waits.
CLUE_EXTERNAL_RESEARCH_WAKE_WORKER_INTERVAL_S=1
CLUE_EXA_WEBSETS_POLL_WORKER_INTERVAL_S=1
CLUE_SUMBLE_API_KEY=
# R0 quarantine — Sumble is out of the research stack (ARV2 provider verdict); key stays unset.
CLUE_SUMBLE_DISCOVERY_GAP_ENRICHMENT_ENABLED=true
CLUE_SUMBLE_ACCOUNT_GAP_ENRICHMENT_ENABLED=true
CLUE_SUMBLE_CENTS_PER_CREDIT=0
CLUE_PARALLEL_API_KEY=
CLUE_FIRECRAWL_API_KEY=
CLUE_CRM_API_KEY=

# --- Durable Stage-0 official-site crawl (FI C6; non-secret, default off) ---
# Shadow mode writes the durable frontier/artifacts/checkpoints only for exact workspace IDs. It
# does not replace the authoritative Client-KB resolver before C7. Authoritative startup currently
# fails closed until the C7 materializer is composed. JSON array or comma-separated allowlist.
CLUE_STAGE0_OFFICIAL_SITE_CRAWL_MODE=off
CLUE_STAGE0_OFFICIAL_SITE_CRAWL_WORKSPACE_ALLOWLIST=[]
# Scrapling is the default scraper everywhere (standing rule: Firecrawl in logs = a
# misconfigured env). Both knobs, so neither lane falls back silently.
CLUE_STAGE0_PAGE_FETCHER=scrapling
CLUE_SCRAPE_BACKEND=scrapling
CLUE_STAGE0_CRAWL_MAX_DEPTH=2
CLUE_STAGE0_CRAWL_FAST_DEADLINE_SECONDS=40
CLUE_STAGE0_CRAWL_FAST_PAGE_CEILING=12
CLUE_STAGE0_CRAWL_TOTAL_PAGE_CEILING=100
CLUE_STAGE0_CRAWL_WORKER_CONCURRENCY=8
CLUE_STAGE0_CRAWL_PER_HOST_CONCURRENCY=3
CLUE_STAGE0_CRAWL_LEASE_TTL_SECONDS=90
CLUE_STAGE0_CRAWL_HEARTBEAT_SECONDS=20
CLUE_STAGE0_CRAWL_REQUEST_TIMEOUT_SECONDS=30
CLUE_STAGE0_CRAWL_MAX_RESPONSE_BYTES=5000000
CLUE_STAGE0_CRAWL_ALLOW_SUBDOMAINS=false
CLUE_STAGE0_CRAWL_ROBOTS_POLICY=respect
CLUE_STAGE0_CRAWL_URL_POLICY_VERSION=official-site-url-v1
# Reserved/pinned for C7 extraction; C6 performs no model call.
CLUE_STAGE0_EXTRACTION_MODEL=openai/gpt-5.6-luna

# --- Scoped memory (Doc M, subsystem two) ---------------------------------------
# ON since 2026-09-20 (founder ruling): the project home's Memory panel writes human notes through
# the scoped-memory seam and every Head-of-ABM turn assembles the project's active memories into
# context. It was parked at ARV2 R0 (2026-09-01) only because its sole writer was the old-lane
# Stage-0 interview; the substrate is advisory and never gates a turn. Each note costs one
# reconcile-judge call (CLUE_MEMORY_RECONCILE_MODEL) from the platform API process, so a real
# CLUE_OPENROUTER_API_KEY is required for writes; with it missing, writes refuse MEMORY_UNAVAILABLE.
# Before turning this on for a database that predates R0, count existing `memory` rows by scope and
# provenance — stale interview-era rows would rejoin the agent's context.
CLUE_MEMORY_ENABLED=true
# Gates POST /auth/v1/provision (self-serve workspace creation) and nothing else since 2026-09-12.
CLUE_SELF_SERVE_PROVISIONING_ENABLED=true
# The OLD Stage-0 recon (/stage0/setup, the STAGE0_RECON handler, the scrape binder, the
# official-site crawl). Off: the Welcome flow runs the new onboarding lane. Kept until the old
# code is retired (defect ledger §G).
CLUE_LEGACY_STAGE0_RECON_ENABLED=false

# --- ARV2 research lane (R1; master plan §9 Track R) ------------------------
# Selects the ARV2 fleet handler and launcher at composition (A7). Default true since the R2
# exit gate passed on 2026-09-08; a worker missing a credential composes no handler and warns.
# New launches use AI Ark committee discovery by default (founder ruling 2026-09-22).
# Historical jobs retain their pinned catalog. Live provider acceptance is tracked separately.
# v4 selects the governed research Deep Agent; new launches pin its current recipe.
# v4 is the new-launch default by founder approval on 2026-09-24; paid acceptance is separate.
CLUE_ARV2_RESEARCH_CATALOG_VERSION=v4
CLUE_ARV2_QUALITY_RECONCILE_INTERVAL_S=10.0
CLUE_ARV2_ACCOUNT_RESEARCH_ENABLED=true
# Minimum seconds between AI Ark calls (proof-of-concept pacing until the paid tier's rate is
# confirmed).
CLUE_ARV2_AI_ARK_MIN_GAP_S=10.5
# Free a provider's slot when it answers and index afterwards (false = index inside the slot).
CLUE_ARV2_DRAIN_OUTSIDE_SLOT=true
# Re-run the evidence recovery check after a call that indexed its own result (false = only on
# replayed calls and once when the job settles).
CLUE_ARV2_RECOVER_ON_SUCCESS=false
# OpenRouter model id for the structuring pass (prose -> claims against the field catalog).
CLUE_ARV2_STRUCTURING_MODEL=openai/gpt-5-mini
# OpenRouter model id for the cheap first pass over short media (law 11's two-model recipe).
CLUE_ARV2_MEDIA_SHORT_MODEL=google/gemini-3.5-flash-lite
# NATIVE Gemini model id — the one ARV2 call that bypasses OpenRouter, which serves neither this
# transcription model nor a file upload. Reads CLUE_GEMINI_API_KEY directly.
# Native public video transcription; v3 only; live route acceptance pending.
CLUE_ARV2_MEDIA_VIDEO_MODEL=gemini-3.5-flash-lite
CLUE_ARV2_MEDIA_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# OpenRouter embeddings model id (text embeddings only — law 11).
CLUE_ARV2_EMBEDDING_MODEL=google/gemini-embedding-2
# Enforced ceiling on media seconds sent to a model in one research run (money truth, §2 item 3).
CLUE_ARV2_MEDIA_SECONDS_CEILING=9000
# Above this duration a media item is not eligible for the cheap short-model pass.
CLUE_ARV2_MEDIA_SHORT_MAX_SECONDS=600
# Where the file raw sink and the JSONL ledger write in development and tests (production routes
# raw bodies to the artifact table and the ledger to provider_call_ledger), and where research
# downloads podcast audio in every environment (deleted once transcribed).
# Production: leave this line out — the backend image sets it (deploy/check_prod_env.py refuses it).
CLUE_ARV2_RAW_ROOT=.artifacts/arv2

# --- ARV2 R2 account agent (founder stop-policy ruling 2026-09-08: full mode, no call caps) ---
# Model rounds per research job (account and person), 350 by founder ruling 2026-09-27; max 500.
# The agent is warned three rounds before the end and finalizes blocked; a safety net, never a budget.
CLUE_ARV2_ACCOUNT_MAX_MODEL_ROUNDS=350
# Tool calls the model may issue in ONE round; the excess get a recoverable refusal.
CLUE_ARV2_ACCOUNT_MAX_TOOL_CALLS_PER_ROUND=50
# Wall clock per research job, seconds. 0 = no timeout (founder ruling 2026-09-27); the
# long-turn alert below still warns. When set, the agent wraps up about 3 minutes before it.
CLUE_ARV2_ACCOUNT_MAX_RUNTIME_S=0
# Recipe 26+ research conversations: past CLEAR_TRIGGER tokens the oldest processed tool results
# are replaced by a short "re-read <path>" placeholder, in steps of (trigger - target) so the
# prompt stays cached; COMPACT_* is the research-only summarising backstop.
CLUE_ARV2_RESEARCH_CLEAR_TRIGGER_TOKENS=100000
CLUE_ARV2_RESEARCH_CLEAR_TARGET_TOKENS=50000
CLUE_ARV2_RESEARCH_COMPACT_TRIGGER_TOKENS=150000
CLUE_ARV2_RESEARCH_COMPACT_KEEP_MESSAGES=40
# Research jobs (account, person, quality continuation) ONE worker process runs at once. A worker
# never claims more research tasks than this; CLUE_FLEET_WORKER_CONCURRENCY is the total across
# all task kinds. Fleet-wide research capacity = batch workers x this value.
CLUE_ARV2_ACCOUNT_MAX_PARALLEL_JOBS=4
# Concurrent calls per provider within one job (AI Ark is always 1 — its pacing is per client).
CLUE_ARV2_ACCOUNT_PROVIDER_CONCURRENCY=4
# Largest podcast enclosure the media tool downloads, MiB.
CLUE_ARV2_ACCOUNT_MEDIA_MAX_ENCLOSURE_MB=200

# --- Deep Agent turn limits (founder ruling 2026-09-27): operator settings, never profile content ---
# Model rounds per Head-of-ABM chat turn (max 500). Warned three rounds before the end; then it
# finalizes awaiting_input so the user can reply "continue".
CLUE_HEAD_OF_ABM_MAX_MODEL_ROUNDS=350
# Conversation compaction, every governed agent (window from OpenRouter unless overridden).
CLUE_AGENT_CONTEXT_WINDOW_TOKENS=
CLUE_AGENT_COMPACT_TRIGGER_FRACTION=0.90
CLUE_AGENT_COMPACT_KEEP_FRACTION=0.10
CLUE_AGENT_COMPACT_TRIGGER_TOKENS=170000
CLUE_AGENT_COMPACT_KEEP_MESSAGES=6
# Head-of-ABM turns resume the thread's last completed turn (append-only, cache-friendly).
CLUE_HEAD_OF_ABM_CONTINUATION_ENABLED=true
# Wall clock per Head-of-ABM chat turn, seconds. 0 = no timeout; when set, wrap-up ~3 minutes before.
CLUE_HEAD_OF_ABM_TURN_TIMEOUT_S=0
# A Head-of-ABM turn or research job running longer than this logs a warning, flags its Langfuse
# trace and sends one Sentry warning; it never stops the turn. 0 turns the alert off.
CLUE_AGENT_LONG_TURN_ALERT_S=3600


# --- ARV2 R3 person agent (master plan §9 R3) -------------------------------
# R3: media items one person job may read (podcast episodes / YouTube appearances); 0 disables media.
CLUE_ARV2_PERSON_MEDIA_MAX_ITEMS=3

# --- ARV2 R4 discovery ------------------------------------------------------
# Composes the discovery handler when on AND CLUE_EXA_API_KEY is configured.
CLUE_ARV2_DISCOVERY_ENABLED=false
# Exa Answer model for gate verification: exa | exa-pro | exa-fast.
CLUE_ARV2_DISCOVERY_ANSWER_MODEL=exa
# Seconds between Websets polls, and the wall clock for one discovery search (a run makes 1 + MAX_TOPUPS).
CLUE_ARV2_DISCOVERY_POLL_INTERVAL_S=15
CLUE_ARV2_DISCOVERY_WALL_S=1800
# Websets bill 10 credits per all-green result; the plan's dollar rate per credit.
CLUE_ARV2_DISCOVERY_WEBSETS_USD_PER_CREDIT=0.00449
# Exa Answer calls one discovery run may have in flight while verifying (candidate pool + one
# candidate's gates asked together). 1 = the serial order of the first R4 runs.
CLUE_ARV2_DISCOVERY_VERIFY_CONCURRENCY=4
# Top-up searches after the first, with the same brief, while a run is short (3 = at most 4 searches).
CLUE_ARV2_DISCOVERY_MAX_TOPUPS=3
# Brandfetch Logo API client id (public; it rides in every <img src>). Empty = no Brandfetch fallback:
# an account with no LinkedIn mark shows the placeholder. The Logo API only — never the Brand API.
CLUE_BRANDFETCH_CLIENT_ID=

# --- ARV2 onboarding lane (Track O; ARV2-ONBOARDING-PLAN.md §10) -----------
# Routes POST /onboarding to the new fleet driver. On by default since 2026-09-12 (the code default
# is also true): the Welcome flow's setting-up screen runs this lane, not the old Stage-0 recon.
CLUE_ONBOARDING_V2_ENABLED=true
# Exa Agent effort per research call (fixed prices: medium $0.10, high $0.50 per run).
CLUE_ONBOARDING_OVERVIEW_EFFORT=high
CLUE_ONBOARDING_REVIEWS_EFFORT=medium
CLUE_ONBOARDING_PRODUCT_EFFORT=medium
# When the customer-reviews run happens: fast | background (ruling O-D3).
CLUE_ONBOARDING_REVIEWS_PHASE=fast
# Cap on concurrent background per-product runs.
CLUE_ONBOARDING_MAX_PARALLEL_RUNS=6
# The persona evidence tool (one deep-reasoning search per persona role; ruling O-D6).
CLUE_ONBOARDING_PERSONA_EVIDENCE_ENABLED=true
# One batched model call per run reconciles lineup entries the spelling key cannot match (page URL as evidence; automatic merge only at high confidence).
CLUE_ONBOARDING_CATALOG_RECONCILE_ENABLED=true
# OpenRouter model for that call.
CLUE_ONBOARDING_RECONCILE_MODEL=openai/gpt-5-mini

# --- ARV2 lenient write gate + annotation checks (D1; master plan §2 items 2/6, §4) ---
# The claim write gate stores instead of refusing (unregistered key -> proposed field; schema miss
# -> schema_valid=false marker; missing URL -> source_missing marker). false = strict refusals.
CLUE_CLAIM_WRITE_LENIENT=true
# on = record a verbatim-quote verdict as a marker on the claim; never a blocker.
CLUE_EVIDENCE_VERBATIM_CHECK=off
# true = the compliance pass purges rows with no quote or no URL; false = it only marks them.
# The purge cannot reach a provider-API record or the hooks claim: both carry neither by design.
CLUE_UNEVIDENCED_ROW_PURGE_ENABLED=false
# on = record whether a typed interview value is entailed by the user's statement; never required.
CLUE_INTERVIEW_ENTAILMENT_CHECK=off
# The one default-on check: redact minors references, mark special-category facts unsafe. Never drops.
CLUE_SENSITIVITY_FLOOR_ENABLED=true

# --- ARV2 display layer (D2; master plan §7) -----------------------------------
# OpenRouter model for focused account reconciliation and the legacy per-section page writer.
CLUE_ARV2_DISPLAY_MODEL=x-ai/grok-4.6
# Per-section HTTP timeout in seconds; sections of a page run in parallel.
CLUE_ARV2_DISPLAY_TIMEOUT_S=240.0
# Sections of one page in flight at once.
CLUE_ARV2_DISPLAY_MAX_PARALLEL=30
# The separate page writer (recipe 25+): HTTP timeout for one page-set call, in seconds.
CLUE_ARV2_PAGE_WRITER_TIMEOUT_S=900.0
# Page writer guides: v2 shows the researcher's interpretation and writes the argument first; v1 rolls back.
CLUE_ARV2_PAGE_GUIDE_VERSION=v2
# The client's one-line pitch the prompt shows as client.what_we_sell (until the O3 artifact).
CLUE_ARV2_DISPLAY_CLIENT_PITCH="AI-native ABM: account and committee research, personalised content, brand-aligned artifacts, scaled per account"
# true = an accounts screen with no stored display block generates it during the request.
CLUE_ARV2_DISPLAY_GENERATE_ON_READ=true
# The fit-band cuts over the 0-1 account.scoring.fit score: >= high is High, >= medium is Medium.
CLUE_ARV2_FIT_HIGH_THRESHOLD=0.7
CLUE_ARV2_FIT_MEDIUM_THRESHOLD=0.4

# --- Conversation naming (chat titles and project names after the first reply) --------
# One cheap call names the chat (and, on the Home path, the project) once the first agent
# reply exists. Off = placeholders stay ("Untitled project" / "New chat").
CLUE_CONVERSATION_NAMING_ENABLED=true
# OpenRouter model id for the naming call.
CLUE_CONVERSATION_NAMING_MODEL=openai/gpt-5.6-luna
# Call timeout in seconds. The turn never waits this long (see NAMING_GRACE_S in
# platform/api/clue_api/conversation_naming.py).
CLUE_CONVERSATION_NAMING_TIMEOUT_S=60.0

# --- Telemetry roots (lane 3 slice 2; the design API added in slice 5) -------------------------
# Installed at the projections API (clue-projections-api), the fleet worker (clue-worker-fleet)
# and the design API (clue-design-api). All off by default; an unconfigured process is as before.
# OTLP/HTTP metrics export: the three settings below predate this block (parity sweep 2026-09-15).
CLUE_METRICS_EXPORTER=memory
CLUE_METRICS_OTLP_ENDPOINT=
CLUE_METRICS_EXPORT_INTERVAL_MS=10000
# OTLP/HTTP traces endpoint (slice 3 points it at Langfuse); empty → spans stay in-process.
CLUE_OTEL_TRACES_ENDPOINT=
# Headers sent with every trace export, "k=v,k2=v2" (a secret: Langfuse basic auth in slice 3).
CLUE_OTEL_TRACES_HEADERS=
# Server spans (FastAPI) and client spans (httpx) at the roots; no endpoint → nothing leaves.
CLUE_OTEL_INSTRUMENT_FASTAPI=true
CLUE_OTEL_INSTRUMENT_HTTPX=true
# Sentry cloud (free tier): installed only when enabled AND a DSN is set; PII off, local vars off.
CLUE_SENTRY_ENABLED=false
CLUE_SENTRY_DSN=
CLUE_SENTRY_ENVIRONMENT=lane-san-salvador
# The code version stamped on Sentry events (a git sha); empty → unset.
CLUE_RELEASE=
# Langfuse (lane 3 slice 3): the agent-tree viewer, cloud project. On by default: installed
# whenever both keys are set, skipped (logged) while they are blank; attaches to the tracer
# provider above (no OTLP endpoint needed). Set false to silence a configured project.
CLUE_LANGFUSE_ENABLED=true
CLUE_LANGFUSE_HOST=https://cloud.langfuse.com
CLUE_LANGFUSE_PUBLIC_KEY=
CLUE_LANGFUSE_SECRET_KEY=
CLUE_LANGFUSE_ENVIRONMENT=lane-san-salvador

# --- Fleet worker concurrency (CLUE_FLEET_*; founder ruling 2026-09-10) ------
# How many tasks ONE fleet worker process drives at once. The remaining CLUE_FLEET_* knobs
# (poll interval, lease TTL, heartbeat, stale window) keep their code defaults and are not
# documented here yet.
# Each of the N drain slots claims independently — the claim is already FOR UPDATE SKIP LOCKED,
# so two slots never take the same row — and the per-task lease and heartbeat are unchanged.
# Research tasks are additionally capped by CLUE_ARV2_ACCOUNT_MAX_PARALLEL_JOBS per process.
CLUE_FLEET_WORKER_CONCURRENCY=3
# Which task kinds this worker process claims: comma-separated FleetTaskKind values, blank = all
# kinds. The hosted VM runs three pools with it — agent_turn (chat), design_job (design), and every
# other kind (batch). An unknown name refuses to start. (first deployment, 2026-10-01)
CLUE_FLEET_WORKER_KINDS=

# --- LLM gateway (direct model calls — M0.4 / conventions §2,§4) ------------
# OpenRouter is the SINGLE egress for all *direct* LLM calls (faithfulness judge M9.3, eval rubric
# scorers M9.6, query-planning M6.1, ICP synthesis M5.2, committee role-inference M8.3, value-narrative
# positioning M12.1). OpenAI-compatible; the model id is config per call site, not code. The Exa/Parallel
# keys above are research-product resolvers (M11), NOT gateway calls (conventions §2 carve-out).
# Leave unset in CI — the gateway runs in deterministic stub mode (no live LLM calls).
CLUE_OPENROUTER_API_KEY=
# The design agent reads its OWN key name — a workspace .env carrying only the CLUE_ key is a
# guaranteed first-run stumble (walk finding F-6; both must be set for design turns).
LUMEN_AGENT_API_KEY=
LUMEN_AGENT_BASE_URL=https://openrouter.ai/api/v1

# --- Deploy-time model ids (non-secret — `clue_research.config.Settings`) -----------------
# OpenRouter model id for ICP synthesis (M5.2). Also the default for `GatewayConfig.synthesis_model`
# and other grounded-synthesis call sites that reuse that config field. Unset → openai/gpt-5.6-terra.
CLUE_SYNTHESIS_MODEL=x-ai/grok-4.6

# OpenRouter model id for every LLM-as-judge call site: the M9.3 faithfulness judge, and through it
# PC-C8 §6c-b's typed-interview-value entailment. Unset → the code default in
# `GatewayConfig.judge_model`, which is a stale id (`anthropic/claude-3.5-sonnet` is no longer
# served by OpenRouter), so a deployment that judges anything should set this.
CLUE_JUDGE_MODEL=x-ai/grok-4.6
# Per-call timeout ceiling for every gateway request AND the maximum a catalog profile may set for
# its model.timeout_s (a profile above it is refused at build time). Founder ruling 2026-09-08: 60.
CLUE_GATEWAY_TIMEOUT_S=60

# --- Agent model configuration (ONE PLACE — every deepagent's model knob lives here) --------
# Founder ruling 2026-08-31: an agent's model is a DEPLOYMENT setting read from the
# environment, never a new reviewed profile version. For each registry role,
# <ROLE>_AGENT_MODEL overrides the catalog profile's pinned model_id at registry resolution
# (blank/unset → the profile pin still applies, so tests and historical replay stay
# deterministic), and <ROLE>_AGENT_MODEL_EFFORT overrides that agent's reasoning effort on
# governed model calls (blank → the per-model baseline in clue_gateway.agent_model). The
# profile keeps owning the envelope (timeout/retries/output budget/temperature); the
# environment names the model.
# Deployment-wide per-call timeout for EVERY agent model call, overriding each profile's
# model.timeout_s (founder ruling 2026-09-08). Bounded by CLUE_GATEWAY_TIMEOUT_S; blank keeps the
# profile pins (tests and replay stay deterministic).
CLUE_AGENT_MODEL_TIMEOUT_S=60
# Fallback chain for EVERY agent model call (founder ruling 2026-10-04): when the primary fails
# before answering (an error, or no first chunk within CLUE_AGENT_FIRST_TOKEN_TIMEOUT_S), the same
# call moves to the next model here, in order. Comma-separated OpenRouter ids; a model equal to the
# primary is skipped; blank = no fallback. (2026-10-04: grok-4.6's xAI endpoint stalled for ~20 min.)
CLUE_AGENT_FALLBACK_MODELS=x-ai/grok-4.7,meta/muse-spark-1.3
# The context window (tokens) of every model above, primaries AND fallbacks, as model=tokens.
# Compaction reads it; a listed model never fetches OpenRouter's catalogue (only an unlisted one
# does — 2026-10-05: a slow catalogue fetch froze a fleet worker for 105 s). Add a model here when
# you add it above. CLUE_AGENT_CONTEXT_WINDOW_TOKENS still overrides every model when set.
CLUE_AGENT_MODEL_CONTEXT_WINDOWS=x-ai/grok-4.6=500000,x-ai/grok-4.7=500000,meta/muse-spark-1.3=1048576
# Seconds a STREAMED agent model call may wait for its first chunk before the next model is tried.
# Pauses after the first chunk stay governed by LANGCHAIN_OPENAI_STREAM_CHUNK_TIMEOUT_S. 0 = none.
CLUE_AGENT_FIRST_TOKEN_TIMEOUT_S=120

# The composer's @-mention directory (2026-10-05): every account and committee contact (names and
# ids only) loads once per session and is searched in the browser, re-checked with an ETag. Above
# this many entries the list is cut (project accounts first) and typing also searches the server.
CLUE_MENTION_DIRECTORY_MAX_ENTRIES=5000
HEAD_OF_ABM_AGENT_MODEL=x-ai/grok-4.6
HEAD_OF_ABM_AGENT_MODEL_EFFORT=
RESEARCH_AGENT_MODEL=x-ai/grok-4.6
RESEARCH_AGENT_MODEL_EFFORT=medium
CONTENT_DRAFTER_AGENT_MODEL=x-ai/grok-4.6
CONTENT_DRAFTER_AGENT_MODEL_EFFORT=
REVIEWER_AGENT_MODEL=x-ai/grok-4.6
REVIEWER_AGENT_MODEL_EFFORT=
ACCOUNT_RESEARCH_AGENT_MODEL=x-ai/grok-4.6
ACCOUNT_RESEARCH_AGENT_MODEL_EFFORT=medium
# Research quality specialists; read by the governed role registry, activated by the research profile.
RESEARCH_CLAIMS_AGENT_MODEL=x-ai/grok-4.6
RESEARCH_CLAIMS_AGENT_MODEL_EFFORT=medium
RESEARCH_NARRATIVE_AGENT_MODEL=x-ai/grok-4.6
RESEARCH_NARRATIVE_AGENT_MODEL_EFFORT=medium
# The ARV2 R2 account research agent (Track R). Read directly by the R2 driver
# (account_research_driver.py); blank EFFORT keeps the model's own default.
ARV2_ACCOUNT_AGENT_MODEL=x-ai/grok-4.6
ARV2_ACCOUNT_AGENT_MODEL_EFFORT=medium
# The ARV2 R3 person research agent (Track R). Read directly by the R3 driver, exactly as the
# account pair above is; blank EFFORT keeps the model's own default.
ARV2_PERSON_AGENT_MODEL=x-ai/grok-4.6
ARV2_PERSON_AGENT_MODEL_EFFORT=medium
DESIGN_AGENT_MODEL=x-ai/grok-4.6
DESIGN_AGENT_MODEL_EFFORT=
# Onboarding synthesis agent (Track O, O4). Ruling O-D1: grok-4.6 at the model's default
# reasoning — leave EFFORT blank. Read by the registry once AgentRole.ONBOARDING_SYNTHESIS exists.
ONBOARDING_SYNTHESIS_AGENT_MODEL=x-ai/grok-4.6
ONBOARDING_SYNTHESIS_AGENT_MODEL_EFFORT=
# The design trio (scene+web deepagent orchestrator/author/reviewer) predates the pattern and
# keeps its OWN env names (subsystems/clue-design; langchain `provider:model` format). Listed
# here so every agent-model knob is in one place; the per-role overrides default to
# LUMEN_AGENT_MODEL when blank.
LUMEN_AGENT_MODEL=openai:x-ai/grok-4.6
LUMEN_AGENT_MODEL_ORCHESTRATOR=
LUMEN_AGENT_MODEL_AUTHOR=
LUMEN_AGENT_MODEL_REVIEWER=openai:x-ai/grok-4.6
# The M8D entity-research account/contact/facet units also predate the pattern: their model
# rides CLUE_SYNTHESIS_MODEL (above), which is a SHARED gateway knob (ICP synthesis, prose,
# entity research) — left as is deliberately; do not fork it per-agent here without deciding
# the shared-knob split first.
# langchain-openai's per-parsed-chunk stall timeout on async streaming (its own env var, default
# 120s): how long the stream may go without yielding a PARSED chunk before it raises. Raised to
# 300 because grok-4.6 composing one long write_file — a whole persona document — can stall past
# 120s mid-tool-call; the runtime catches that as a TimeoutError and reports the turn
# `agent_timeout`, which is what killed live turn bba614e3. 300 equals head-of-abm's own
# turn_timeout_s, so a stall can never outlive the turn it is in.
LANGCHAIN_OPENAI_STREAM_CHUNK_TIMEOUT_S=300

# Temporary M9 runtime-verification switch. False skips deterministic corroboration and prevents
# M9.3 faithfulness-judge calls in the verification phase, reverse profiling, and toolbelt
# entailment paths. It does not promote unverified claims or disable pre-spend, contact identity
# binding, freshness/retention, or the separate M10 use gate.
#
# R0 step 5 (ARV2-R0-foundations-plan Part 6): OFF. Flipped only AFTER the Part 3C inversion
# fixes landed — that ordering is the whole point. Until they did, turning this off made the
# Stage-0 interview unable to write typed values, and an inline Sumble corroborator kept gating
# field resolution regardless of this switch. Off removes corroboration and the faithfulness
# judge at its four composition roots (verification phase, reverse profiling, prose, toolbelt
# entailment — see toolbelt_wiring.py:2701, which composes entailment_judge=None here), and the
# merge serves unverified tier-4 claims. Claim write-shape validation and the human authority
# gates are unaffected.
CLUE_VERIFICATION_ENABLED=false

# --- Local Sumble-only Clue Trial (founder acceptance canary) --------------
# This surface is default-off and binds to loopback. It requires canonical C7 reads in the same
# process. Do not enable it on a public interface; it is not the production authentication surface.
CLUE_TRIAL_ENABLED=false
CLUE_TRIAL_HOST=127.0.0.1
CLUE_TRIAL_PORT=8010
CLUE_TRIAL_ROOT=.context/sumble-trials
CLUE_C7_RESEARCH_VIEW_READ_ENABLED=false

# --- Authenticated principal edge (Lane B B5 prepared; deployment flip waits for Lane D D5) ---
# Clerk authenticates only. FastAPI verifies the short-lived *default session token* (no JWT
# template, no audience claim; signature + issuer + azp-allowlist) against the instance JWKS,
# then resolves the provider subject to Clue-owned platform_user/workspace_membership rows.
# Authorized parties may be a JSON array or comma-separated origins. Never place real keys in
# this example or `_memory/`.
CLUE_AUTH_ENABLED=true
CLUE_AUTH_ENVIRONMENT=local
CLUE_AUTH_MODE=clerk
CLUE_AUTH_CLERK_JWKS_URL=https://precise-lamb-56.clerk.accounts.dev/.well-known/jwks.json
CLUE_AUTH_CLERK_ISSUER=https://precise-lamb-56.clerk.accounts.dev
# Backend invitation delivery and verified primary-email reads; secret placeholder only.
CLUE_AUTH_CLERK_SECRET_KEY=
CLUE_APP_ORIGIN=http://localhost:3033
CLUE_AUTH_CLERK_AUDIENCE=clue-api
CLUE_AUTH_CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3033,http://127.0.0.1:3033,https://app.cluehq.ai
# Production must set AUTH_ENABLED=true, AUTH_ENVIRONMENT=production, AUTH_MODE=clerk, and use
# authenticated_principal. Construction refuses local_header or a missing principal service.
# local_header is local/test only and is never a production rollback mode.
CLUE_PROJECTIONS_AUTH_MODE=authenticated_principal
LUMEN_AGENT_REASONING=medium

# --- Platform deepagent workspace (C6.1; non-secret) ------------------------
# Dedicated ephemeral execution root. Must be an absolute canonical path outside and unrelated to
# both the deployed source worktree and the service user's home. Do not point this at the repo,
# `$HOME`, artifact storage, or a shared temp directory. The service creates only the final root
# component and requires its parent to exist.
CLUE_AGENT_WORKSPACE_ROOT=
# Default-off production ownership routing. The master switch dominates both surface switches.
# Existing route receipts are immutable: changing these values affects only a subject with no
# prior route. The allowlist is a JSON array; percentage is deterministic per
# workspace+surface (0–100).
CLUE_AGENT_RUNTIME_ROUTING_ENABLED=true
CLUE_AGENT_STAGE0_ROUTING_ENABLED=true
CLUE_AGENT_ACCOUNT_ROUTING_ENABLED=true
CLUE_AGENT_WORKSPACE_ALLOWLIST=[]
CLUE_AGENT_CANARY_PERCENT=0
# Hard ceiling for one account agent's validated C5 plan; the durable account envelope clamps it
# further at runtime.
CLUE_AGENT_ACCOUNT_PLAN_BUDGET_LIMIT_MILLICENTS=1000000
# A chat thread's workspace directory (its scratch/ and reads/ notebooks) is purged when the
# thread is archived, or this many seconds after its newest turn went terminal; an in-flight or
# awaiting-input turn keeps it. Non-positive cleanup cadence disables only the scheduler.
CLUE_AGENT_WORKSPACE_RETENTION_S=86400
CLUE_AGENT_CLEANUP_INTERVAL_S=3600

# --- FI Lane D: production chat surface (dev-enabled quickstart) ----------------------------
# The /api/v1 chat router (threads, turns, gates, SSE stream). Default off; on for local dev.
CLUE_CHAT_ENABLED=true
# The development principal's Clue-owned ids (local_header auth mode only; provisioned as REAL
# platform_user/workspace_membership rows at startup via clue_auth — startup fails if it can't).
# The workspace id is REQUIRED when chat is enabled in dev: a membership belongs to exactly one
# workspace, so it cannot come from the request selector. Use your dev workspace's id.
CLUE_CHAT_DEV_PRINCIPAL_USER_ID=usr_local_dev
CLUE_CHAT_DEV_PRINCIPAL_MEMBERSHIP_ID=wsm_local_dev
CLUE_CHAT_DEV_PRINCIPAL_WORKSPACE_ID=
# D3 token streaming (defaults shown; rarely need changing).
CLUE_CHAT_TURN_STREAMING_ENABLED=true
CLUE_CHAT_TURN_STREAM_BATCH_MAX_CHARS=256
CLUE_CHAT_TURN_STREAM_BATCH_INTERVAL_S=0.05
CLUE_CHAT_TURN_STOP_POLL_INTERVAL_S=0.25
CLUE_CHAT_TURN_EVENT_RETENTION_S=86400
CLUE_CHAT_SWEEP_INTERVAL_S=60
CLUE_CHAT_STREAM_TOKEN_TTL_S=300
CLUE_CHAT_STREAM_POLL_INTERVAL_S=0.25
# Chat attachments (spec 2026-09-18): per-message ceilings and the prior-turn image re-send cap.
CLUE_CHAT_ATTACHMENT_MAX_FILES=10
CLUE_CHAT_ATTACHMENT_MAX_TOTAL_BYTES=157286400
CLUE_CHAT_ATTACHMENT_IMAGE_MAX_BYTES=10485760
CLUE_CHAT_ATTACHMENT_TEXT_MAX_BYTES=5242880
CLUE_CHAT_ATTACHMENT_HISTORY_IMAGES_MAX=20
# Document attachments (spec 2026-09-19): the per-file cap of a PDF / DOCX / PPTX / XLSX / CSV /
# JSON attachment. The file reaches the agent as-is; it reads it with run_python.
CLUE_CHAT_ATTACHMENT_DOCUMENT_MAX_BYTES=26214400
# The agent code sandbox (spec 2026-09-19 §3.4). On by default (founder, 2026-09-20): one
# `docker run` per run_python call with these bounds. The image must be built on every worker
# host with `make sandbox-image`; without it (or with the flag off) run_python refuses and a
# binary attachment is unreadable to the agent (it says so; it does not guess).
CLUE_SANDBOX_ENABLED=true
CLUE_SANDBOX_IMAGE=clue-agent-sandbox:latest
CLUE_SANDBOX_TIMEOUT_S=60
CLUE_SANDBOX_CPUS=1
CLUE_SANDBOX_MEMORY_MB=1024
CLUE_SANDBOX_MAX_RUNS_PER_TURN=10
CLUE_SANDBOX_MAX_OUTPUT_BYTES=1048576
# Dev lens (BOTH refuse production startup — structurally dev-only).
# raw = stream the provider's reasoning/thinking onto the reasoning card (provider-dependent:
# Anthropic = real thinking text; OpenAI o-series = model-written summary; plain models = nothing).
CLUE_CHAT_REASONING_TRACE_MODE=raw
# CLUE_CHAT_REASONING_THINKING_BUDGET_TOKENS=
# The per-turn context inspector drawer (L1-L7 bytes, rounds, plan, tools).
CLUE_CHAT_DEV_INSPECTOR_ENABLED=true
CLUE_CHAT_DEV_INSPECTOR_BUDGET_BYTES=512000
# Research launch from chat (the D4 gate flow's final step). Off by default; the fleet worker
# needs it on (plus a model key) for launch_account_research to execute.
# R0 quarantine (ARV2-R0-foundations-plan Part 3B): the old M8D research lane is inert with this
# off — no ENTITY_RESEARCH_JOB handler is registered and the launch tools refuse typed. NOTE the
# integration_pilot overlay would force this back ON, so the pilot product path must not be used
# with the R0 posture. Founder ruling 2026-09-10 (O6): this stays OFF everywhere — the lane is
# legacy; account and contact research run on the ARV2 lane (CLUE_ARV2_ACCOUNT_RESEARCH_ENABLED).
CLUE_ENTITY_RESEARCH_RUNTIME_ENABLED=false

# --- Design API base URL (server-side only) --------------------------------------------------
# Where the platform reaches the design API (lumen_api) as a SERVICE. Today exactly one platform
# surface uses it: first-time onboarding enqueues ONE brand-kit website ingestion through the
# design API's own guarded route (POST /brand-kits/ingest/website), so the client's Brand-context
# screen has a real DRAFT kit to review. Unset = the platform makes no server-side design-API
# calls and the trigger simply does not fire (a posture, not an error). This is a backend-to-
# backend URL and must never be exposed to a browser; the frontend has its own LUMEN_API_BASE_URL
# for its server-side BFF proxy.
CLUE_DESIGN_API_BASE_URL=http://127.0.0.1:8013
# Onboarding also offers ONE ad-assets harvest for the company's own LinkedIn ads, in parallel
# with the website ingestion (POST /brand-ad-assets/onboard, phase=harvest): the most recent
# static ads, up to MAX_CREATIVES, reading at most MAX_PAGES ad-library pages (~25 ads and ~1
# Adyntel credit each). The ad-DNA card is distilled later, once both the harvest and a brand kit
# exist. Needs LUMEN_BRAND_AD_ASSETS=1 on the design API; without it the offer is a logged skip.
CLUE_BRAND_AD_ASSETS_AUTO_ONBOARD=true
CLUE_BRAND_AD_ASSETS_AUTO_MAX_CREATIVES=50
CLUE_BRAND_AD_ASSETS_AUTO_MAX_PAGES=8
# Design runtime master switch: gates the 49 design tools + open/finish_design_leg on the
# platform API and the design_job lane on clue_api.fleet_main. Off => open_design_leg
# refuses (design_leg_runtime_not_configured) before any DB touch.
CLUE_DESIGN_RUNTIME_ENABLED=1
# Scene preference context is staged until output-history erasure closure and explicit
# preference writes are validated. Off preserves legacy design turns; ordinary platform
# memory remains independent. Enable only for explicit evaluation of the staged integration.
CLUE_DESIGN_PREFERENCE_CONTEXT_ENABLED=false
# Browser origins allowed on the design API (dev stack: platform frontend + editor hosts).
LUMEN_API_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:3210,http://localhost:3210,http://127.0.0.1:3033,http://localhost:3033


# --- Public pages: hostnames and delivery (custom-domain publishing spec 2026-09-17 §9) ---------
# Values here are the production defaults. The dev stack (scripts/dev_stack.sh) overrides four of
# them per process: suffix pages.localhost, scheme http, port 8040, trust-host-header true.
CLUE_PAGES_SYSTEM_SUFFIX=pages.cluehq.ai
CLUE_PAGES_PUBLIC_SCHEME=https
CLUE_PAGES_PUBLIC_PORT=
CLUE_PAGES_EDGE_SECRET=
CLUE_PAGES_TRUST_HOST_HEADER=false
CLUE_PAGES_ORIGIN_PORT=8040
# Custom domains (S2): the CNAME target shown to customers, and the Cloudflare for SaaS control plane.
# Token + zone empty = the Connect action answers 503 PROVIDER_NOT_CONFIGURED; everything else works.
CLUE_PAGES_CNAME_TARGET=pages.cluehq.ai
CLUE_CLOUDFLARE_API_TOKEN=
CLUE_CLOUDFLARE_ZONE_ID=

# Brand-kit ingestion assistance runs inside the design API. Deployment posture is ON for both
# vision enrichment of guideline PDFs and multimodal descriptions of harvested assets. Keep the
# subsystem's intrinsic defaults off for deterministic library/test use; these env overrides are
# the deployment default. OPENROUTER_API_KEY is the design ingestion gateway setting (distinct env
# namespace from CLUE_OPENROUTER_API_KEY above); the monorepo recipe reuses the same secret by
# reference, without duplicating its value. If blank, both enabled assists make zero network calls
# and the existing deterministic extraction path completes normally.
#
# The line below is now belt-and-braces rather than load-bearing. W5/R2-B (2026-08-26) found a
# real `.env` written before it landed: the design side resolved no key at all, so the ad-DNA
# distiller wrote no card and its job still reported `succeeded`. `py_lumen_config` therefore
# falls back to CLUE_OPENROUTER_API_KEY whenever OPENROUTER_API_KEY is unset or blank, in the one
# place the design subsystem resolves this credential. Keep the line — it documents the reuse and
# survives a shell that exports only what it sources — but a `.env` missing it is no longer inert.
OPENROUTER_API_KEY="${CLUE_OPENROUTER_API_KEY}"
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LUMEN_INGESTION_VISION=1
LUMEN_AGENT_WEB_SOLO=1

# Clone-fidelity F3/F4, FOUNDER RULING R-X4 (2026-08-29): what a repair lineage resolves to when
# EVERY released member of it is marked broken — the harvested original AND every repair of it.
# One option, two values:
#
#   keep_flagged       (DEFAULT) the newest released repair stays selected and is reported as
#                      degraded and requiring review at every surface that already reports
#                      degraded (the pin warning, the picker, the recreate walk's report, the
#                      inspector card). The ruling in the founder's words: "never silently
#                      return to a known-broken original".
#   fallback_original  the pre-ruling behaviour, kept as a deliberate choice: the OLDEST approved
#                      member wins, which for a family that still holds its harvested original IS
#                      that original. Choose this only where seating the client's own broken band
#                      is preferable to seating a repair that was later measured broken.
#
# It changes ONLY that arm. A family with one healthy member still resolves to it under both
# values, and two released repairs that neither supersede each other still refuse under both.
# An unrecognized value fails loudly at startup rather than resolving to either.
LUMEN_DEGRADED_REPAIR_SELECTION=keep_flagged
# Describe every eligible ingested image automatically; concurrency bounds in-flight work.
LUMEN_INGESTION_DESCRIBE=1
# The per-brand Creative Brief (design-quality Wave 1, W1.6 / ruling R2): website
# ingestion always force-renders now, and a rendered re-extraction that publishes
# briefless silently wastes the render. Still silent when no key is configured.
LUMEN_INGESTION_BRIEF=1
# Optional model overrides; unset keeps py_lumen_config's existing model policy.
# LUMEN_INGESTION_VISION_MODEL=
# LUMEN_INGESTION_DESCRIBE_MODEL=deepseek/deepseek-v4.1-flash
# LUMEN_INGESTION_BRIEF_MODEL=

# Text-to-image (design imagery). The design web/scene lanes generate real
# imagery through lumen_api.image_provider → OpenRouter chat-completions with
# the image modality. Model chosen 2026-08-20 by live probe of every
# image-output model on OpenRouter: gemini-3.1-flash-image is the fastest of
# the models that actually honor an aspect-ratio hint (16:9 → 1376x768; the
# 2.5-flash and gpt-5-image families return 1024x1024 regardless), ~14s and
# ~$0.068 per image. See _memory/2026-08-20-web-imagery-four-defects.md.
IMAGE_MODEL_BASE_URL=https://openrouter.ai/api/v1
IMAGE_MODEL_API_KEY=${CLUE_OPENROUTER_API_KEY}
# Selected 2026-09-16: GPT Image 2.5 Flare through the dedicated Images API.
# Historical model probes above do not override this explicit selection.
IMAGE_MODEL_ID=openai/gpt-image-2.5-flare
IMAGE_MODEL_API_STYLE=images
IMAGE_MODEL_TIMEOUT_S=300

# Pilot budget-controls master switch (FI-pilot-budget-controls). true keeps today's
# behaviour. false is the pilot posture: no cost/budget number reaches any model- or
# human-visible surface, and nothing on the platform stops a pre-approved action on budget
# grounds (hard spend control lives at the provider consoles). Spend RECORDING is unaffected
# in both modes -- reservations, settlements, spent_cents, and cost observability keep
# accruing, so a pilot deployment over-spends visibly rather than silently.
CLUE_BUDGET_CONTROLS_ENABLED=false

CLUE_VALUE_NARRATIVE_SYNTHESIS_ENABLED=true

# --- Brand Ad Assets lane (LUMEN_BRAND_AD_ASSETS) --------------------------------------------
# Master switch. 0/absent = the lane's routes are not even registered. 1 = onboarding can
# harvest a client's published ads, describe them, pre-generate imagery, and the design
# deepagent auto-attaches the harvested references on scene turns.
LUMEN_BRAND_AD_ASSETS=1

# The ad-library FETCH vendor: given an advertiser, hand back a page of their published ads.
ADYNTEL_API_KEY=
ADYNTEL_EMAIL=

# The company-IDENTITY resolver (W5/R3-A). Answers "which LinkedIn page is this domain" from a
# source that is NOT the ad library, so the harvest can be addressed by a verified page id.
#
# Why it exists: the ad library's own domain resolution is not evidence. For apollo.io it
# answered LinkedIn page 107285417 -- a real page with genuinely zero ads -- while Apollo's true
# page is 18511550 (135 ads). The harvest came back empty, the job reported success, and the
# resolved id never reached the caller. Two full rounds of W5 acceptance testing were spent
# chasing a number the pipeline never showed anyone.
#
# BLANK IS SAFE AND IS THE DEFAULT. With no key the lane falls back to the vendor's own domain
# resolution -- exactly the pre-R3-A behaviour -- and says so at the top level of the job:
# `resolver_used: "ad_library_domain"`, `advertiser_verified: false`. It never pretends the
# fallback was verified. The advertiser-name cross-check still gates custody either way.
#
# One enrichment is one credit. PDL_BASE_URL accepts EITHER the API host (as below) or the full
# enrichment endpoint (https://api.peopledatalabs.com/v5/company/enrich) -- the resolver folds
# both to one URL, because a doubled path would 404 in a way indistinguishable from "no such
# company", which is the same quiet-misresolution shape this whole mechanism exists to end.
PDL_API_KEY=
PDL_BASE_URL=https://api.peopledatalabs.com
PDL_TIMEOUT_S=30

# Brandfetch — target-account logo vendor (design subsystem). BRANDFETCH_API_KEY is the
# Brand API Bearer key (blank disables Brandfetch; official-site retrieval remains
# available). BRANDFETCH_CLIENT_ID is the PUBLIC Logo-API client id embedded in
# published-page <img> URLs for decorative third-party logos (blank = hotlink guidance
# omitted from web prompts). Both from https://developers.brandfetch.com/register.
BRANDFETCH_API_KEY=
BRANDFETCH_CLIENT_ID=
BRANDFETCH_API_BASE_URL=https://api.brandfetch.io
BRANDFETCH_TIMEOUT_S=20

# Prebuilt lumen-api-helper binary the design API and fleet worker run for every engine call.
# Empty → `cargo run -p lumen-api-helper` (debug profile, rebuilt on demand). scripts/dev_stack.sh
# sets it to subsystems/clue-design/target/release/lumen-api-helper — which does NOT rebuild
# itself: after any change under subsystems/clue-design/crates/, run
# `cargo build -p lumen-api-helper --release` there and restart the stack (AGENTS.md §1).
# Production: leave this line out — the backend image sets it (deploy/check_prod_env.py refuses it).
LUMEN_CORE_HELPER=
LUMEN_CORE_HELPER_LOG=1

# Stealth render backend (Scrapling-hardened Chromium) as the default for rendered website
# capture — paints WebGL heroes and defeats bot walls. Default ON; 0 falls back to the plain
# Playwright renderer (a plain fetch can never impersonate a full one).
LUMEN_RENDER_STEALTH=1
# QA renderers (page thumbnail, clone-review walk) present a normal Chrome User-Agent so
# Brandfetch's hotlinked logos render for review (founder decision 2026-09-02, plan D11).
# Default ON; 0 restores the headless UA. Never applied to the editor or to publish.
# The logo ladder (target-logo scrape, second rung behind Brandfetch) fetches with a real Chrome
# TLS/HTTP fingerprint (curl_cffi impersonation, scrapling's engine), so Cloudflare-walled sites
# answer instead of 403 (founder decision 2026-09-02). Default ON; 0 restores plain httpx.

# --- Fleet worker (platform/fleet, settings.py "fleet worker" block) ---------------------------
# How often an idle worker polls the task queue, seconds.
CLUE_FLEET_POLL_INTERVAL_S=1.0
# Per-run driver-lease TTL (a killed driver's run is re-drivable after this long), seconds.
CLUE_FLEET_LEASE_TTL_S=30.0
# How often a driving worker renews its run lease, seconds (must be < half the TTL).
CLUE_FLEET_HEARTBEAT_INTERVAL_S=10.0
# How long a claimed fleet_task is honoured before it is presumed orphaned and re-owned, seconds.
CLUE_FLEET_TASK_STALE_AFTER_S=60.0
# Threads in one worker process, shared by every blocking provider call and the event loop's DNS
# lookups (including the lease heartbeat's). Started on demand. Python's default is min(32, cpu+4).
CLUE_FLEET_THREAD_POOL_SIZE=128
# Deep-phase concurrency window: account jobs in flight at once per project run.
CLUE_FLEET_DEEP_WINDOW=16

# Self-serve provisioning: mounts POST /auth/v1/provision (a signed-in user with no workspace
# creates one from the onboarding form) and registers the Stage-0 recon handler on the fleet
# worker. Was exported by hand on demo night 2026-08-27; recorded here 2026-09-07.

# --- Platform settings recorded for env parity (2026-09-08 audit) -------------------------
# Every field of clue_config.Settings that had no line in this file, written at its CODE default
# (so nothing changes behaviour). A commented line means the default is unset/None; uncomment to set.
# Descriptions live beside each field in libs/clue-config/clue_config/settings.py.
# CLUE_METRICS_OTLP_ENDPOINT=   (default: unset)
CLUE_EXA_ACCOUNT_DEEP_SEARCH_TYPE=deep-reasoning
CLUE_EXA_ACCOUNT_DEEP_MAX_RESULTS=50
CLUE_EXA_ACCOUNT_DEEP_MAX_ADDITIONAL_QUERIES=10
CLUE_SUMBLE_COMMITTEE_POLL_AFTER_S=30
CLUE_SUMBLE_COMMITTEE_WAKE_WORKER_INTERVAL_S=1.0
CLUE_RECIPE1_ROUTING_ENABLED=false
# CLUE_RECIPE1_WORKSPACE_ALLOWLIST=["ws_…"]   (default: empty; JSON list)
CLUE_RECIPE1_CANARY_PERCENT=0
CLUE_RECIPE1_SUPERVISOR_POLICY_VERSION=supervisor-v1
CLUE_RECIPE_EXECUTOR_MAX_CONCURRENCY=32
CLUE_MEMORY_RECONCILE_MODEL=openai/gpt-5.6-terra
CLUE_DESIGN_REAPER_INTERVAL_S=300.0
CLUE_ENTITY_RESEARCH_UNPRICED_RESERVATION_CENTS=1
CLUE_ENTITY_RESEARCH_PROVIDER_CONCURRENCY_LIMIT=8
CLUE_ENTITY_RESEARCH_SUMBLE_PROVIDER_CREDIT_CAP=25
CLUE_C7_SNAPSHOT_COMPOSE_ENABLED=false
CLUE_C7_EVIDENCE_ACTIONS_ENABLED=false
CLUE_C7_RECHECK_ENABLED=false
CLUE_C7_PRODUCTION_HANDOFF_ENABLED=false
CLUE_C7_LEGACY_DOSSIER_ALIAS_ENABLED=false
CLUE_C7_GOVERNANCE_SHADOW_COMPARE_ENABLED=false
# CLUE_C7_WORKSPACE_CANARY_IDS=["ws_…"]   (default: empty; JSON list)
# CLUE_FRONTEND_CORS_ALLOW_ORIGINS=["https://…"]   (default: empty; JSON list)
# CLUE_CHAT_REASONING_THINKING_BUDGET_TOKENS=   (default: unset)
CLUE_PROJECTIONS_HOST=127.0.0.1
CLUE_PROJECTIONS_PORT=8000
# The address the backend image's APIs listen on (docker/backend/entrypoint.sh). The design API sets
# :: on Railway (reachable only over Railway's IPv6 private network; :: is IPv6-only). Not read by
# the dev stack.
CLUE_BIND_HOST=0.0.0.0
CLUE_STORAGE_ORPHAN_SWEEP_INTERVAL_S=21600.0
# Log a lock-holding database section (artifact saves, evidence publish, dossier import) as
# db.critical_section when it holds its lock at least this many milliseconds.
CLUE_DB_CRITICAL_SECTION_LOG_MS=500
CLUE_COMPOSER_REGISTRY_CACHE_SIZE=8
CLUE_GATEWAY_ALLOW_STUB=false
CLUE_TOOLBELT_IDEMPOTENCY_TTL_S=86400.0
CLUE_SSE_REPLAY_HORIZON_S=86400.0
CLUE_SSE_STREAM_TOKEN_TTL_S=300.0
CLUE_SSE_REPLAY_PAGE_LIMIT=10000
CLUE_STAGE0_FAST_BUDGET_CENTS=25
CLUE_STAGE0_BACKGROUND_BUDGET_CENTS=100
CLUE_STAGE0_EXTRACTION_CONCURRENCY=4
CLUE_STREAM_TOKEN_SWEEP_INTERVAL_S=3600.0
CLUE_DESIGN_RUN_EVENT_PRUNE_INTERVAL_S=0.0
CLUE_DESIGN_RUN_EVENT_RETENTION_S=2592000.0

# --- Design-subsystem settings recorded for env parity (2026-09-08 audit) --------------------
# Every py_lumen_config field that had no line in this file, at its CODE default (no behaviour change).
# A commented line means the default is unset/None. Descriptions: packages/py-lumen-config/py_lumen_config/config.py.
# LUMEN_ASSET_STORE_ROOT=   (default: unset)
LUMEN_ASSET_MAX_BYTES=10485760
LUMEN_LOG_LEVEL=INFO
# LUMEN_CORE_HELPER=   (default: unset)
LUMEN_DESIGN_REAPER_INTERVAL_S=300.0
LUMEN_FRAGMENT_MINT_CAP=40
IMAGE_MODEL_PROVIDER_ID=image-gen-v1
IMAGE_MODEL_MAX_RETRIES=2
# IMAGE_MODEL_HTTP_REFERER=   (default: unset)
# IMAGE_MODEL_APP_TITLE=   (default: unset)
LUMEN_INGESTION_ASSIST=0
LUMEN_INGESTION_ASSIST_MODEL=x-ai/grok-4.5
LUMEN_INGESTION_VISION_MODEL=x-ai/grok-4.5
LUMEN_INGESTION_DESCRIBE_MODEL=deepseek/deepseek-v4.1-flash
LUMEN_INGESTION_BRIEF_MODEL=x-ai/grok-4.7
LUMEN_INGESTION_BRIEF_REASONING=medium
ADYNTEL_BASE_URL=https://api.adyntel.com
ADYNTEL_TIMEOUT_S=60.0
LUMEN_AD_DNA_MODEL=x-ai/grok-4.5
LUMEN_AGENT_MAX_ITERATIONS=5
LUMEN_AGENT_PREVIEW_FORMAT=svg
# LUMEN_AGENT_WORKSPACE_ROOT=   (default: unset)
# LUMEN_AGENT_TRACE_DIR=   (default: unset)
# LUMEN_AGENT_ASSET_STORE=   (default: unset)
# LUMEN_AGENT_MAX_TOKENS=   (default: unset)
LUMEN_AGENT_PROVIDER_SORT=latency
# LUMEN_AGENT_FALLBACK_MODEL=   (default: unset)
LUMEN_AGENT_LLM_TIMEOUT_S=60.0
LUMEN_AGENT_AUTO_DEFAULTS=0
LUMEN_AGENT_FAST_LOOP=1
# Scene-only skill catalog: legacy or candidate. Isolate workspaces per bundle.
LUMEN_AGENT_SCENE_SKILL_BUNDLE=candidate
# Candidate viewing profile; empty disables the numeric floor (code default).
# compact-feed-v1: 8px; legible-feed-v1: 10px nominal em at 360px display width.
# Selected for the local feed-ad evaluation; not a print/general-scene rule.
LUMEN_AGENT_SCENE_REVIEW_PROFILE=legible-feed-v1
# One scene agent with no delegation; requires candidate bundle + FAST_LOOP=1.
LUMEN_AGENT_SCENE_SOLO=0
LUMEN_AGENT_SCENE_REVIEWER=0
LUMEN_AGENT_WEB_FAST_LOOP=0
LUMEN_AGENT_WEB_REVIEWER=0
LUMEN_AGENT_FAST_LOOP_TARGET_LLM_CALLS=20
LUMEN_AGENT_FAST_LOOP_TARGET_WALL_CLOCK_S=240.0
LUMEN_AGENT_FAST_LOOP_MAX_LLM_CALLS=90
LUMEN_AGENT_FAST_LOOP_WALL_CLOCK_S=1800.0
LUMEN_AGENT_FAST_LOOP_INNER_ITERATIONS=4
# LUMEN_AGENT_FAST_LOOP_PINNED_KNOWLEDGE=   (default: unset)
LUMEN_AGENT_AUTOFIX_MAX_PASSES=2
# ANTHROPIC_API_KEY=   (default: unset)
# --- Local dev stack (scripts/dev_stack.sh knobs; defaults = the istanbul port map) ---
# Every port, the database and the log-file prefix of the five-process dev stack come from
# these DEV_STACK_* keys (the names scripts/dev_stack.sh reads; see DEV_STACK.md). The values
# below ARE the script's built-in defaults, so an env that sets none of them runs exactly the
# stack the script always ran. A SECOND worktree running side by side sets its own values in a
# lane wrapper script (its own DB, its own four ports, its own log prefix, plus its own absolute
# CLUE_STORAGE_FS_ROOT) — that is the whole point of the keys.
DEV_STACK_DB_URL=postgresql+psycopg://aryankeshri@localhost/clue_istanbul_dev
# Frontend (Next.js) — THE app port; must match CLUE_APP_ORIGIN, the Clerk authorized parties
# allowlist and the design API's CORS list, or sign-in/chat-send break one symptom at a time.
DEV_STACK_FRONTEND_PORT=3033
# Optional frontend-only pinned local instance. Both empty by default; see
# apps/frontend/.env.example. Existing active membership is always required.
CLUE_LOCAL_WORKSPACE_ID=
CLUE_LOCAL_WORKSPACE_NAME=
# Design API (lumen_api.main:app) — also what CLUE_DESIGN_API_BASE_URL/LUMEN_API_ORIGIN are built from.
DEV_STACK_DESIGN_PORT=8013
# Platform API (clue_api.projections_main:app) — the frontend's CLUE_API_BASE_URL target.
DEV_STACK_PLATFORM_PORT=8023
# Platform API, second instance (historical twin of the first).
DEV_STACK_PLATFORM2_PORT=8033
# Log-file prefix: <prefix>_<name>.log (e.g. /tmp/browser_fleet_worker.log).
DEV_STACK_LOG_PREFIX=/tmp/browser
# How many fleet worker PROCESSES scripts/dev_stack.sh starts, and how many drain slots each
# runs (CLUE_FLEET_WORKER_CONCURRENCY). A stack people test on runs 4 x 4 (founder rulings
# 2026-09-08 / 2026-09-10); the defaults reproduce the historical single sequential worker.
DEV_STACK_WORKERS=4
DEV_STACK_WORKER_CONCURRENCY=3
# Agent workspace root handed to every platform process (CLUE_AGENT_WORKSPACE_ROOT).
DEV_STACK_AGENT_WORKSPACE_ROOT=/private/tmp/clue-agent-workspaces

# Web design deepagent loop shape (see py_lumen_config; D-F7 + solo ruling 2026-09-04).
# SOLO=1: ONE agent — director, designer, and customer-eyes judge in a single loop; both
# web subagents quarantined; merged solo prompt; plan.md is the working memory. 0 restores
# the trio (orchestrator + author + reviewer). The two flags below only matter at SOLO=0:
# WEB_FAST_LOOP=1 quarantines just the reviewer (self-review, same rubric);
# WEB_REVIEWER=1 puts the reviewer back without leaving the fast loop.

# Non-OpenAI design-agent models (grok-4.6 default) over OpenRouter chat-completions instead
# of the /responses bridge (2026-09-04: a 136s grok generation on /responses died mid-stream
# with "Auth context expired" and took a six-minute run with it). 0 restores /responses.
LUMEN_AGENT_OPENROUTER_CHAT_COMPLETIONS=1
# --- Product path + the contract-§9 activation surface (FI-comprehensive-account-contact) ---
# Which checked-in deployment posture this process runs. `default` is today's flag-by-flag
# behaviour (every capability below stays off unless you set it). `integration_pilot` applies the
# checked-in overlay in `clue_config.settings.INTEGRATION_PILOT_OVERLAY` — the *activation record*
# for the required-capability table in docs/FI-comprehensive-account-contact-research-contract.md
# §9 — as DEFAULTS, so the pilot deployment needs only this one knob plus real provider keys. An
# explicitly provided value (env var here or `.env`) always wins over an overlay entry, so any
# single capability can still be pinned off (or on) without leaving the pilot path. On the pilot
# path a missing required credential is a LOUD startup refusal (`product_path_preflight`), never a
# silently degraded provider slot.
CLUE_PRODUCT_PATH=default
# The values below stay at their code defaults on purpose: this file documents the NAMES, and the
# overlay — not this example file — is the activation record for the pilot path.
# So an operator running the pilot path from a copy of this file must DELETE (or flip) ANY explicit
# line for an overlay-covered flag, whatever its value — an explicit env value wins over the
# overlay in both directions, so a `=true` line holds a flag the overlay turns OFF just as a
# `=false` line holds one it turns on.
# Beyond the §9 rows below, the overlay also pins CLUE_ENTITY_RESEARCH_RUNTIME_ENABLED and
# CLUE_CHAT_ENABLED on, and CLUE_VERIFICATION_ENABLED / CLUE_BUDGET_CONTROLS_ENABLED off — the
# last two are documented as `=true` above (the conservative default path), so on the pilot path
# those two lines must go.
# §9 "Exa account deep research" — needs CLUE_EXA_API_KEY.
CLUE_EXA_ACCOUNT_DEEP_ACQUISITION_ENABLED=false
# §9 "Sumble committee discovery" — needs CLUE_SUMBLE_API_KEY.
CLUE_SUMBLE_COMMITTEE_ACQUISITION_ENABLED=false
# §9 "C7 snapshot composition" — exposes newly completed research (overlay entry lands in slice G).
CLUE_C7_SNAPSHOT_COMPOSE_ENABLED=false
# §9 "Production handoff" — the C7 handoff cutover (overlay entry lands in slice G).
CLUE_C7_PRODUCTION_HANDOFF_ENABLED=false
# §9 "Frontend read integration" — the workspace-scoped /frontend/v1 read router.
CLUE_FRONTEND_READ_ENABLED=true
# CORS origins for the frontend read surface; empty = same-origin only.
CLUE_FRONTEND_CORS_ALLOW_ORIGINS=
# The remaining §9 rows are documented at their own sections above and are already in the overlay:
# Exa Websets discovery (CLUE_EXA_WEBSETS_{LIFECYCLE,ACQUISITION}_ENABLED), Sumble account
# enrichment (CLUE_SUMBLE_ACCOUNT_GAP_ENRICHMENT_ENABLED), and Exa contact deep research
# (CLUE_EXA_CONTACT_DEEP_ACQUISITION_ENABLED). Three more join the overlay later, so today the
# pilot path leaves them off: validated contact channels (CLUE_CONTACT_CHANNEL_ENRICHMENT_ENABLED)
# and frontend contact email lookup (CLUE_FRONTEND_CONTACT_EMAIL_LOOKUP_ENABLED) in slice F, C7
# research-view reads (CLUE_C7_RESEARCH_VIEW_READ_ENABLED) in slice G. The one §9 row with no env
# var (Sumble structured contact enrichment) is a production action-routing decision.

# --- keys the local deployment reads that were undocumented here (parity sweep 2026-09-09) ---
# Brandfetch (brand-kit onboarding ingestion). Credentials stay blank here.
# Design subsystem (lumen) runtime needs for the design leg: the API origin the deepagent previews
# against, the native helper binary (absolute path, machine-specific), and two render/QA switches.
LUMEN_API_ORIGIN=http://127.0.0.1:8013
LUMEN_LADDER_IMPERSONATE_CHROME=1
LUMEN_QA_RENDER_UA_OVERRIDE=1
# Optional design scratch paths (empty = the design API's defaults); a stack launcher may pin them.
LUMEN_AGENT_WORKSPACE_ROOT=''
# A design session's memory lives under <trace_dir>/sessions/<session_id>/ and its compaction
# history under <trace_dir>/conversation_history/<session_id>.md (media/ is shared). Erasure
# removes both with the session's runs, so point this at a path the worker really owns.
LUMEN_AGENT_TRACE_DIR=''
# 1 = the design API drains its own fleet work (scripts/dev_stack.sh); 0 = detached platform workers own it.
LUMEN_EMBEDDED_FLEET_WORKER=1
# Absolute in the monorepo: API and worker processes have different working directories.
# Production: leave this line out — the backend image sets it (deploy/check_prod_env.py refuses it).
LUMEN_FONT_LIBRARY_MANIFEST_PATH='/absolute/path/to/your/checkout/subsystems/clue-design/apps/api/font-library/manifest.json'

# Continuous per-image enrichment; limits simultaneous requests, never coverage.
# Shared across asset-analysis jobs using the same provider credential via CLUE_REDIS_URL.
LUMEN_INGESTION_DESCRIBE_CONCURRENCY=40
# Output cap per described asset (max_tokens; a multi-asset call multiplies it, ceiling 131072).
# Measured 2026-09-29: legitimate analyses median ~4.5k / p99 ~15k output tokens; runaways hit 131072.
LUMEN_INGESTION_DESCRIBE_MAX_TOKENS_PER_ASSET=32768
# On-demand ingestion: one coordinator, four image workers with ten slots each.
# These processes stop after idle; the lightweight controller remains available.
LUMEN_INGESTION_POOL_WORKERS=4
LUMEN_INGESTION_WORKER_CONCURRENCY=10
LUMEN_INGESTION_POOL_IDLE_SECONDS=60
LUMEN_INGESTION_POOL_POLL_SECONDS=2
# The ingestion CONTROLLER's own database URL. Empty = CLUE_DATABASE_URL. The worker VM sets the
# direct Postgres URL here: the controller holds a session advisory lock, which PgBouncer's
# transaction pooling would break; its children stay on CLUE_DATABASE_URL (PgBouncer).
LUMEN_INGESTION_CONTROLLER_DATABASE_URL=
