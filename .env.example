# Clue-HQ Research & Data subsystem — environment variables (M0.4 / ENG-120).
#
# Copy to `.env` and fill in real values for LOCAL DEV ONLY. `.env` is git-ignored
# (see .gitignore) and MUST NEVER be committed. This file documents the variable NAMES
# with placeholders ONLY — it holds no real secrets.
#
# All secret values are read once via `clue_research.config.Secrets` (pydantic-settings BaseSettings,
# env_prefix=CLUE_) and injected; nothing reads os.environ ad hoc. Non-secret deploy knobs (e.g.
# CLUE_SYNTHESIS_MODEL) are read via `clue_research.config.Settings` / `load_settings()`.
# pydantic SecretStr and redacted by `clue_research.config.redact` before any log/trace.

# --- Database (shared seam) -------------------------------------------------
# The Postgres DSN. OWNED/documented by M0.4 (config/); the db/ package (M0.3) reads the SAME
# variable. This is the one spelling of the DB DSN env var across the whole subsystem.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
CLUE_DATABASE_URL=postgresql+asyncpg://clue:CHANGEME@localhost:5432/clue

# --- Durable artifact storage (shared by API + every worker) -----------------
# Local full-stack processes that share CLUE_DATABASE_URL MUST also use the same explicit,
# persistent storage root. Do not pair a long-lived/reused database with a disposable /tmp root:
# Postgres retains the content address but cannot reconstruct missing message bytes. Prefer an
# absolute path so API and worker cannot interpret a relative root from different directories.
CLUE_STORAGE_BACKEND=fs
CLUE_STORAGE_FS_ROOT=/absolute/persistent/path/to/clue-artifacts
# Production should use one shared S3-compatible backend (or a proven shared persistent volume),
# never container-local ephemeral files. Bucket/endpoint/region are non-secret; credentials are
# secrets and remain empty in this example.
CLUE_STORAGE_S3_BUCKET=
CLUE_STORAGE_S3_ENDPOINT_URL=
CLUE_STORAGE_S3_REGION=
CLUE_STORAGE_S3_ACCESS_KEY_ID=
CLUE_STORAGE_S3_SECRET_ACCESS_KEY=

# --- Redis (in-flight locks + rate-limit coordination — M2.4) ---------------
# The Redis DSN. The shared seam read by clue_research.locks (NOT a source of truth — Postgres is;
# Redis holds ephemeral lock/rate-limit state only, conventions §6). The lock tests skip gracefully
# when this is unset / unreachable. Format: redis://[:PASSWORD@]HOST:PORT/DB
CLUE_REDIS_URL=redis://localhost:6379/0

# --- Provider API keys (resolvers — M4) -------------------------------------
# Each provider is "just a resolver" behind the Resolver protocol; the key is read here, not in
# the caller, so a Clay -> direct-API swap changes which key is read, not any downstream code.
# Leave any unused provider unset (the field defaults to None; M0 ships no live integration).
CLUE_CLAY_API_KEY=
CLUE_APOLLO_API_KEY=
CLUE_ZOOMINFO_API_KEY=
CLUE_BUILTWITH_API_KEY=
CLUE_DUNS_API_KEY=
CLUE_EXA_API_KEY=
CLUE_EXA_WEBSETS_WEBHOOK_SECRET=
CLUE_EXA_WEBSETS_LIFECYCLE_ENABLED=false
CLUE_EXA_WEBSETS_ACQUISITION_ENABLED=false
CLUE_EXA_TARGETED_ENRICHMENT_ENABLED=false
# M8C C6: selected-contact Exa Search is independently authorized from account profiling.
CLUE_EXA_CONTACT_DEEP_ACQUISITION_ENABLED=false
# C5 channel acquisition additionally requires an accepted validator-backed production binding.
CLUE_CONTACT_CHANNEL_ENRICHMENT_ENABLED=false
# Provider-neutral re-offer cadence for committee/contact external waits.
CLUE_EXTERNAL_RESEARCH_WAKE_WORKER_INTERVAL_S=1
CLUE_EXA_WEBSETS_POLL_WORKER_INTERVAL_S=1
CLUE_SUMBLE_API_KEY=
CLUE_SUMBLE_DISCOVERY_GAP_ENRICHMENT_ENABLED=false
CLUE_SUMBLE_ACCOUNT_GAP_ENRICHMENT_ENABLED=false
CLUE_SUMBLE_CENTS_PER_CREDIT=0
CLUE_PARALLEL_API_KEY=
CLUE_FIRECRAWL_API_KEY=
CLUE_CRM_API_KEY=

# --- Durable Stage-0 official-site crawl (FI C6; non-secret, default off) ---
# Shadow mode writes the durable frontier/artifacts/checkpoints only for exact workspace IDs. It
# does not replace the authoritative Client-KB resolver before C7. Authoritative startup currently
# fails closed until the C7 materializer is composed. JSON array or comma-separated allowlist.
CLUE_STAGE0_OFFICIAL_SITE_CRAWL_MODE=off
CLUE_STAGE0_OFFICIAL_SITE_CRAWL_WORKSPACE_ALLOWLIST=[]
CLUE_STAGE0_PAGE_FETCHER=firecrawl
CLUE_STAGE0_CRAWL_MAX_DEPTH=2
CLUE_STAGE0_CRAWL_FAST_DEADLINE_SECONDS=40
CLUE_STAGE0_CRAWL_FAST_PAGE_CEILING=12
CLUE_STAGE0_CRAWL_TOTAL_PAGE_CEILING=100
CLUE_STAGE0_CRAWL_WORKER_CONCURRENCY=8
CLUE_STAGE0_CRAWL_PER_HOST_CONCURRENCY=3
CLUE_STAGE0_CRAWL_LEASE_TTL_SECONDS=90
CLUE_STAGE0_CRAWL_HEARTBEAT_SECONDS=20
CLUE_STAGE0_CRAWL_REQUEST_TIMEOUT_SECONDS=30
CLUE_STAGE0_CRAWL_MAX_RESPONSE_BYTES=5000000
CLUE_STAGE0_CRAWL_ALLOW_SUBDOMAINS=false
CLUE_STAGE0_CRAWL_ROBOTS_POLICY=respect
CLUE_STAGE0_CRAWL_URL_POLICY_VERSION=official-site-url-v1
# Reserved/pinned for C7 extraction; C6 performs no model call.
CLUE_STAGE0_EXTRACTION_MODEL=openai/gpt-5.6-luna

# --- LLM gateway (direct model calls — M0.4 / conventions §2,§4) ------------
# OpenRouter is the SINGLE egress for all *direct* LLM calls (faithfulness judge M9.3, eval rubric
# scorers M9.6, query-planning M6.1, ICP synthesis M5.2, committee role-inference M8.3, value-narrative
# positioning M12.1). OpenAI-compatible; the model id is config per call site, not code. The Exa/Parallel
# keys above are research-product resolvers (M11), NOT gateway calls (conventions §2 carve-out).
# Leave unset in CI — the gateway runs in deterministic stub mode (no live LLM calls).
CLUE_OPENROUTER_API_KEY=

# --- Deploy-time model ids (non-secret — `clue_research.config.Settings`) -----------------
# OpenRouter model id for ICP synthesis (M5.2). Also the default for `GatewayConfig.synthesis_model`
# and other grounded-synthesis call sites that reuse that config field. Unset → openai/gpt-5.6-terra.
CLUE_SYNTHESIS_MODEL=openai/gpt-5.6-terra

# OpenRouter model id for every LLM-as-judge call site: the M9.3 faithfulness judge, and through it
# PC-C8 §6c-b's typed-interview-value entailment. Unset → the code default in
# `GatewayConfig.judge_model`, which is a stale id (`anthropic/claude-3.5-sonnet` is no longer
# served by OpenRouter), so a deployment that judges anything should set this.
CLUE_JUDGE_MODEL=openai/gpt-5.6-terra

# Temporary M9 runtime-verification switch. False skips deterministic corroboration and prevents
# M9.3 faithfulness-judge calls in the verification phase, reverse profiling, and toolbelt
# entailment paths. It does not promote unverified claims or disable pre-spend, contact identity
# binding, freshness/retention, or the separate M10 use gate.
CLUE_VERIFICATION_ENABLED=true

# --- Local Sumble-only Clue Trial (founder acceptance canary) --------------
# This surface is default-off and binds to loopback. It requires canonical C7 reads in the same
# process. Do not enable it on a public interface; it is not the production authentication surface.
CLUE_TRIAL_ENABLED=false
CLUE_TRIAL_HOST=127.0.0.1
CLUE_TRIAL_PORT=8010
CLUE_TRIAL_ROOT=.context/sumble-trials
CLUE_C7_RESEARCH_VIEW_READ_ENABLED=false

# --- Authenticated principal edge (Lane B B5 prepared; deployment flip waits for Lane D D5) ---
# Clerk authenticates only. FastAPI verifies the short-lived *default session token* (no JWT
# template, no audience claim; signature + issuer + azp-allowlist) against the instance JWKS,
# then resolves the provider subject to Clue-owned platform_user/workspace_membership rows.
# Authorized parties may be a JSON array or comma-separated origins. Never place real keys in
# this example or `_memory/`.
CLUE_AUTH_ENABLED=false
CLUE_AUTH_ENVIRONMENT=local
CLUE_AUTH_MODE=local_fixture
CLUE_AUTH_CLERK_JWKS_URL=
CLUE_AUTH_CLERK_ISSUER=
CLUE_AUTH_CLERK_AUTHORIZED_PARTIES=[]
# Production must set AUTH_ENABLED=true, AUTH_ENVIRONMENT=production, AUTH_MODE=clerk, and use
# authenticated_principal. Construction refuses local_header or a missing principal service.
# local_header is local/test only and is never a production rollback mode.
CLUE_PROJECTIONS_AUTH_MODE=local_header

# --- Platform deepagent workspace (C6.1; non-secret) ------------------------
# Dedicated ephemeral execution root. Must be an absolute canonical path outside and unrelated to
# both the deployed source worktree and the service user's home. Do not point this at the repo,
# `$HOME`, artifact storage, or a shared temp directory. The service creates only the final root
# component and requires its parent to exist.
CLUE_AGENT_WORKSPACE_ROOT=
# Default-off production ownership routing. The master switch dominates both surface switches.
# Existing route receipts are immutable: changing these values affects only a subject with no
# prior route. The allowlist is a JSON array; percentage is deterministic per
# workspace+surface (0–100).
CLUE_AGENT_RUNTIME_ROUTING_ENABLED=false
CLUE_AGENT_STAGE0_ROUTING_ENABLED=false
CLUE_AGENT_ACCOUNT_ROUTING_ENABLED=false
CLUE_AGENT_WORKSPACE_ALLOWLIST=[]
CLUE_AGENT_CANARY_PERCENT=0
# Hard ceiling for one account agent's validated C5 plan; the durable account envelope clamps it
# further at runtime.
CLUE_AGENT_ACCOUNT_PLAN_BUDGET_LIMIT_MILLICENTS=1000000
# Terminal execution roots remain locally inspectable for this many seconds, then the fleet
# cleanup loop removes them after their outputs and finalization are durable. Non-positive cleanup
# cadence disables only the scheduler.
CLUE_AGENT_WORKSPACE_RETENTION_S=86400
CLUE_AGENT_CLEANUP_INTERVAL_S=3600

# --- FI Lane D: production chat surface (dev-enabled quickstart) ----------------------------
# The /api/v1 chat router (threads, turns, gates, SSE stream). Default off; on for local dev.
CLUE_CHAT_ENABLED=true
# The development principal's Clue-owned ids (local_header auth mode only; provisioned as REAL
# platform_user/workspace_membership rows at startup via clue_auth — startup fails if it can't).
# The workspace id is REQUIRED when chat is enabled in dev: a membership belongs to exactly one
# workspace, so it cannot come from the request selector. Use your dev workspace's id.
CLUE_CHAT_DEV_PRINCIPAL_USER_ID=usr_local_dev
CLUE_CHAT_DEV_PRINCIPAL_MEMBERSHIP_ID=wsm_local_dev
CLUE_CHAT_DEV_PRINCIPAL_WORKSPACE_ID=
# D3 token streaming (defaults shown; rarely need changing).
CLUE_CHAT_TURN_STREAMING_ENABLED=true
CLUE_CHAT_TURN_STREAM_BATCH_MAX_CHARS=256
CLUE_CHAT_TURN_STREAM_BATCH_INTERVAL_S=0.05
CLUE_CHAT_TURN_STOP_POLL_INTERVAL_S=0.25
CLUE_CHAT_TURN_EVENT_RETENTION_S=86400
CLUE_CHAT_SWEEP_INTERVAL_S=60
CLUE_CHAT_STREAM_TOKEN_TTL_S=300
CLUE_CHAT_STREAM_POLL_INTERVAL_S=0.25
# Dev lens (BOTH refuse production startup — structurally dev-only).
# raw = stream the provider's reasoning/thinking onto the reasoning card (provider-dependent:
# Anthropic = real thinking text; OpenAI o-series = model-written summary; plain models = nothing).
CLUE_CHAT_REASONING_TRACE_MODE=raw
# CLUE_CHAT_REASONING_THINKING_BUDGET_TOKENS=
# The per-turn context inspector drawer (L1-L7 bytes, rounds, plan, tools).
CLUE_CHAT_DEV_INSPECTOR_ENABLED=true
CLUE_CHAT_DEV_INSPECTOR_BUDGET_BYTES=512000
# Research launch from chat (the D4 gate flow's final step). Off by default; the fleet worker
# needs it on (plus a model key) for launch_account_research to execute.
CLUE_ENTITY_RESEARCH_RUNTIME_ENABLED=true

# Pilot budget-controls master switch (FI-pilot-budget-controls). true keeps today's
# behaviour. false is the pilot posture: no cost/budget number reaches any model- or
# human-visible surface, and nothing on the platform stops a pre-approved action on budget
# grounds (hard spend control lives at the provider consoles). Spend RECORDING is unaffected
# in both modes -- reservations, settlements, spent_cents, and cost observability keep
# accruing, so a pilot deployment over-spends visibly rather than silently.
CLUE_BUDGET_CONTROLS_ENABLED=true
