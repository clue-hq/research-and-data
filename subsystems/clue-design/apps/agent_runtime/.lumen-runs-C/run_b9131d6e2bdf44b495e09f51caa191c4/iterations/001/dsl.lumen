page poster size(1080,1080,px)
  artboard al(v, x(s), y(s), g($space.section), pad(96)) p(0,0) s(fill,fill) fill($surface.page) clip(true)
    header al(h, x(s), y(c), g(12), pad(0)) p(0,0) s(888,hug)
      mark al(h, x(c), y(c), pad(0)) p(0,0) s(44,44) fill($surface.brand) rd($radius.badge)
        markt text "LC" p(0,0) s(fill,hug) align(center) style($type.eyebrow) max_lines(1)
      logo text "Lumen Workspace" p(0,0) s(400,hug) style($type.label) wrap_text(true) max_lines(1) slot(account.name)
    main al(v, x(s), y(c), g($space.stack.default), pad(0)) p(0,0) s(888,fill)
      kicker text "NEW FEATURE" p(0,0) s(888,hug) style($type.eyebrow) wrap_text(true) max_lines(1) slot(campaign.eyebrow)
      headline text "Live Collaboration" p(0,0) s(888,hug) style($type.headline) font_size($type.size.7xl) lh(1.04) wrap_text(true) max_lines(2) slot(campaign.headline)
      subtitle text "Comment, resolve, and version together." p(0,0) s(820,hug) style($type.body) lh(1.4) wrap_text(true) max_lines(2) slot(offer.primary_message)
      markers al(h, x(s), y(s), g(24), pad(0)) p(0,0) s(888,hug)
        m1 al(v, x(s), g($space.stack.tight), pad(0)) p(0,0) s(280,hug)
          m1chip al(h, x(c), y(c), pad(0)) p(0,0) s(56,56) fill($surface.brand.subtle) rd($radius.full)
            m1icon svg(icon:dot) p(0,0) s(28,28) fill($surface.brand)
          m1label text "Comment" p(0,0) s(280,hug) style($type.subtitle) lh(1.2) wrap_text(true) max_lines(1) slot(feature.1.label)
        m2 al(v, x(s), g($space.stack.tight), pad(0)) p(0,0) s(280,hug)
          m2chip al(h, x(c), y(c), pad(0)) p(0,0) s(56,56) fill($surface.brand.subtle) rd($radius.full)
            m2icon svg(icon:check) p(0,0) s(28,28) fill($surface.brand)
          m2label text "Resolve" p(0,0) s(280,hug) style($type.subtitle) lh(1.2) wrap_text(true) max_lines(1) slot(feature.2.label)
        m3 al(v, x(s), g($space.stack.tight), pad(0)) p(0,0) s(280,hug)
          m3chip al(h, x(c), y(c), pad(0)) p(0,0) s(56,56) fill($surface.brand.subtle) rd($radius.full)
            m3icon svg(icon:arrow-up) p(0,0) s(28,28) fill($surface.brand)
          m3label text "Version" p(0,0) s(280,hug) style($type.subtitle) lh(1.2) wrap_text(true) max_lines(1) slot(feature.3.label)
    footer al(h, x(sb), y(c), g($space.md), pad(0)) p(0,0) s(888,hug)
      cta al(h, x(c), y(c), pad(18,36)) p(0,0) s(300,72) fill($surface.brand) rd($radius.button)
        cta_text text "See What's New" p(0,0) s(fill,hug) align(center) style($type.cta) max_lines(1) slot(campaign.cta)
      url text "yourapp.com" p(0,0) s(320,hug) style($type.caption) align(right) wrap_text(true) max_lines(1) slot(account.url)
  #slot:account.name sample("Lumen Workspace") worst_case("Lumen Workspace Studio")
  #slot:campaign.eyebrow sample("NEW FEATURE") worst_case("NEW FEATURE")
  #slot:campaign.headline sample("Live Collaboration") worst_case("Live Collaboration")
  #slot:offer.primary_message sample("Comment, resolve, and version together.") worst_case("Comment, resolve, and version together in one place.")
  #slot:feature.1.label sample("Comment") worst_case("Comment")
  #slot:feature.2.label sample("Resolve") worst_case("Resolve")
  #slot:feature.3.label sample("Version") worst_case("Version")
  #slot:campaign.cta sample("See What's New") worst_case("See What's New")
  #slot:account.url sample("yourapp.com") worst_case("yourapp.com")