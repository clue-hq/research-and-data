page page_a4 preset(a4,portrait)
  artboard al(v, x(s), g($space.stack.loose), pad(48)) p(0,0) s(fill,fill) fill($surface.page) clip(true)
    header al(h, x(sb), y(c), g($space.md), pad(0)) p(0,0) s(499,hug)
      brand al(h, x(s), y(c), g(12), pad(0)) p(0,0) s(260,hug)
        mark al(h, x(c), y(c), pad(0)) p(0,0) s(40,40) fill($surface.brand) rd($radius.full)
          markg svg(icon:sparkles) p(0,0) s(22,22) fill($surface.inverse)
        logo text "Lumen" p(0,0) s(200,hug) style($type.label) wrap_text(true) max_lines(1) slot(account.name)
      tag text "ON-BRAND DESIGN, IN MINUTES" p(0,0) s(230,hug) style($type.caption) align(right) wrap_text(true) max_lines(1) slot(account.tagline)
    main al(v, x(s), y(s), g($space.stack.loose), pad(0)) p(0,0) s(499,fill)
      hero al(v, x(s), g($space.stack.tight), pad(0)) p(0,0) s(499,hug)
        eyebrow text "HOW IT WORKS" p(0,0) s(499,hug) style($type.eyebrow) wrap_text(true) max_lines(1) slot(campaign.eyebrow)
        headline text "How Lumen works." p(0,0) s(499,hug) style($type.headline) lh(1.12) wrap_text(true) max_lines(2) slot(campaign.headline)
        subtitle text "Three steps from brief to brand-ready artifact." p(0,0) s(499,hug) style($type.body.small) lh(1.4) wrap_text(true) max_lines(2) slot(offer.primary_message)
      list al(v, x(s), g($space.stack.loose), pad(0)) p(0,0) s(499,hug)
        r1 al(h, x(s), y(s), g(20), pad(0)) p(0,0) s(499,hug)
          n1 al(h, x(c), y(c), pad(0)) p(0,0) s(56,56) fill($surface.brand.subtle) rd($radius.full)
            n1i svg(icon:pencil) p(0,0) s(28,28) fill($surface.brand)
          t1 al(v, x(s), g(6), pad(0)) p(0,0) s(423,hug)
            t1t text "Brief it" p(0,0) s(423,hug) style($type.subtitle) lh(1.15) wrap_text(true) max_lines(1) slot(step.1.title)
            t1d text "Describe the artifact you need in plain language." p(0,0) s(423,hug) style($type.body.small) lh(1.4) wrap_text(true) max_lines(2) slot(step.1.desc)
        r2 al(h, x(s), y(s), g(20), pad(0)) p(0,0) s(499,hug)
          n2 al(h, x(c), y(c), pad(0)) p(0,0) s(56,56) fill($surface.brand.subtle) rd($radius.full)
            n2i svg(icon:sparkles) p(0,0) s(28,28) fill($surface.brand)
          t2 al(v, x(s), g(6), pad(0)) p(0,0) s(423,hug)
            t2t text "It composes on-brand" p(0,0) s(423,hug) style($type.subtitle) lh(1.15) wrap_text(true) max_lines(1) slot(step.2.title)
            t2d text "Lumen generates a layout that follows your brand system." p(0,0) s(423,hug) style($type.body.small) lh(1.4) wrap_text(true) max_lines(2) slot(step.2.desc)
        r3 al(h, x(s), y(s), g(20), pad(0)) p(0,0) s(499,hug)
          n3 al(h, x(c), y(c), pad(0)) p(0,0) s(56,56) fill($surface.brand.subtle) rd($radius.full)
            n3i svg(icon:check) p(0,0) s(28,28) fill($surface.brand)
          t3 al(v, x(s), g(6), pad(0)) p(0,0) s(423,hug)
            t3t text "Approve and export" p(0,0) s(423,hug) style($type.subtitle) lh(1.15) wrap_text(true) max_lines(1) slot(step.3.title)
            t3d text "Review the result and export a production-ready file." p(0,0) s(423,hug) style($type.body.small) lh(1.4) wrap_text(true) max_lines(2) slot(step.3.desc)
    footer al(h, x(sb), y(c), g($space.md), pad(0)) p(0,0) s(499,hug)
      contact text "hello@lumen.design" p(0,0) s(219,hug) style($type.caption) wrap_text(true) max_lines(1) slot(account.contact)
      cta al(h, x(c), y(c), pad(16,32)) p(0,0) s(260,64) fill($surface.inverse) rd($radius.button)
        cta_text text "Start Designing" p(0,0) s(fill,hug) style($type.cta) align(center) max_lines(1) slot(campaign.cta)
  #slot:account.name sample("Lumen") worst_case("Lumen Studio")
  #slot:account.tagline sample("ON-BRAND DESIGN, IN MINUTES") worst_case("ON-BRAND DESIGN, IN MINUTES")
  #slot:campaign.eyebrow sample("HOW IT WORKS") worst_case("HOW IT WORKS")
  #slot:campaign.headline sample("How Lumen works.") worst_case("How Lumen works.")
  #slot:offer.primary_message sample("Three steps from brief to brand-ready artifact.") worst_case("Three steps from brief to brand-ready artifact.")
  #slot:step.1.title sample("Brief it") worst_case("Brief it")
  #slot:step.1.desc sample("Describe the artifact you need in plain language.") worst_case("Describe the artifact you need in plain language.")
  #slot:step.2.title sample("It composes on-brand") worst_case("It composes on-brand")
  #slot:step.2.desc sample("Lumen generates a layout that follows your brand system.") worst_case("Lumen generates a layout that follows your brand system.")
  #slot:step.3.title sample("Approve and export") worst_case("Approve and export")
  #slot:step.3.desc sample("Review the result and export a production-ready file.") worst_case("Review the result and export a production-ready file.")
  #slot:account.contact sample("hello@lumen.design") worst_case("hello@lumen.design")
  #slot:campaign.cta sample("Start Designing") worst_case("Start Designing")