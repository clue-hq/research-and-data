page pipeline_slide size(1920,1080,px)
  #slot:campaign.eyebrow sample("PIPELINE COVERAGE BY STAGE") worst_case("PIPELINE COVERAGE BY STAGE AND SEGMENT")
  #slot:stat.coverage sample("4.2x") worst_case("4.2x")
  #slot:stat.target sample("$18M") worst_case("$18.0M")
  #slot:offer.takeaway sample("Every stage clears the 3x coverage bar, giving healthy margin against the $18M target.") worst_case("Every stage clears the 3x coverage bar, giving healthy margin against the $18M target this fiscal year.")
  #slot:stage.1.value sample("$24.8M") worst_case("$248.8M")
  #slot:stage.1.label sample("Discovery") worst_case("Discovery")
  #slot:stage.2.value sample("$21.4M") worst_case("$214.4M")
  #slot:stage.2.label sample("Qualification") worst_case("Qualification")
  #slot:stage.3.value sample("$17.9M") worst_case("$179.9M")
  #slot:stage.3.label sample("Proposal") worst_case("Proposal")
  #slot:stage.4.value sample("$11.5M") worst_case("$115.5M")
  #slot:stage.4.label sample("Negotiation") worst_case("Negotiation")
  artboard al(v, x(s), y(s), g($space.section), pad(80)) p(0,0) s(fill,fill) fill($surface.page) clip(true)
    header al(h, x(sb), y(c)) s(1760,hug)
      kicker text "PIPELINE COVERAGE BY STAGE" slot(campaign.eyebrow) style($type.eyebrow) c($accent.primary) s(1200,hug) wrap_text(true) max_lines(1)
      context text "FY QUOTA REVIEW" style($type.eyebrow) c($text.muted) s(360,hug) align(right) wrap_text(true) max_lines(1)
    hero al(v, x(s), y(c), g($space.lg)) s(1760,fill)
      stats al(h, x(s), y(e), g($space.2xl)) s(1760,hug)
        coverage al(v, x(s), y(s), g($space.xs)) s(760,hug)
          coverage_value text "4.2x" slot(stat.coverage) style($type.stat) font_size($type.size.9xl) c($accent.primary) s(760,hug) wrap_text(true) max_lines(1)
          coverage_label text "pipeline coverage ratio" style($type.body.small) c($text.muted) s(760,hug) wrap_text(true) max_lines(1)
        target al(v, x(s), y(s), g($space.xs)) s(520,hug)
          target_value text "$18M" slot(stat.target) style($type.stat) font_size($type.size.6xl) c($text.primary) s(520,hug) wrap_text(true) max_lines(1)
          target_label text "quota target (FY)" style($type.body.small) c($text.muted) s(520,hug) wrap_text(true) max_lines(1)
      takeaway text "Every stage clears the 3x coverage bar, giving healthy margin against the $18M target." slot(offer.takeaway) style($type.subtitle) c($text.secondary) s(1000,hug) wrap_text(true) max_lines(2)
    stages al(h, x(sb), y(s), g($space.lg)) s(1760,hug)
      stage_1 al(v, x(s), y(s), g($space.md)) s(410,hug) fill($surface.card) rd($radius.lg) pad($space.card.padding)
        stage_1_rule r s(fill,4) fill($accent.primary) rd($radius.full)
        stage_1_value text "$24.8M" slot(stage.1.value) style($type.stat) font_size($type.size.4xl) c($text.primary) s(346,hug) wrap_text(true) max_lines(1)
        stage_1_label text "Discovery" slot(stage.1.label) style($type.body.small) c($text.muted) s(346,hug) wrap_text(true) max_lines(1)
      stage_2 al(v, x(s), y(s), g($space.md)) s(410,hug) fill($surface.card) rd($radius.lg) pad($space.card.padding)
        stage_2_rule r s(fill,4) fill($accent.primary) rd($radius.full)
        stage_2_value text "$21.4M" slot(stage.2.value) style($type.stat) font_size($type.size.4xl) c($text.primary) s(346,hug) wrap_text(true) max_lines(1)
        stage_2_label text "Qualification" slot(stage.2.label) style($type.body.small) c($text.muted) s(346,hug) wrap_text(true) max_lines(1)
      stage_3 al(v, x(s), y(s), g($space.md)) s(410,hug) fill($surface.card) rd($radius.lg) pad($space.card.padding)
        stage_3_rule r s(fill,4) fill($accent.primary) rd($radius.full)
        stage_3_value text "$17.9M" slot(stage.3.value) style($type.stat) font_size($type.size.4xl) c($text.primary) s(346,hug) wrap_text(true) max_lines(1)
        stage_3_label text "Proposal" slot(stage.3.label) style($type.body.small) c($text.muted) s(346,hug) wrap_text(true) max_lines(1)
      stage_4 al(v, x(s), y(s), g($space.md)) s(410,hug) fill($surface.card) rd($radius.lg) pad($space.card.padding)
        stage_4_rule r s(fill,4) fill($accent.primary) rd($radius.full)
        stage_4_value text "$11.5M" slot(stage.4.value) style($type.stat) font_size($type.size.4xl) c($text.primary) s(346,hug) wrap_text(true) max_lines(1)
        stage_4_label text "Negotiation" slot(stage.4.label) style($type.body.small) c($text.muted) s(346,hug) wrap_text(true) max_lines(1)
    footer al(h, x(s), y(c)) s(1760,hug)
      source text "Source: CRM pipeline snapshot, FY quota model" style($type.caption) c($text.muted) s(1760,hug) wrap_text(true) max_lines(1)