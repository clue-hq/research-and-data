page quote_card size(1080,1350,px)
  artboard al(v, x(s), y(s), g($space.section), pad(96)) p(0,0) s(fill,fill) fill($surface.brand) clip(true)
    main al(v, x(s), y(c), g($space.stack.default), pad(0)) p(0,0) s(888,fill)
      quote_mark text "“" p(0,0) s(888,hug) style($type.display) font_size($type.size.8xl) fill($text.inverse) o($opacity.muted) max_lines(1)
      quote text "Lumen replaced three vendors and a week of design ops." p(0,0) s(888,hug) style($type.headline) font_size($type.size.6xl) lh(1.08) fill($text.inverse) wrap_text(true) max_lines(4) slot(quote.text)
      accent_rule r p(0,0) s(96,6) fill($accent.default) rd($radius.full)
      author_name text "Priya N." p(0,0) s(888,hug) style($type.subtitle) fill($text.inverse) wrap_text(true) max_lines(1) slot(author.name)
      author_role text "VP Brand, Northwind" p(0,0) s(888,hug) style($type.body.small) lh(1.4) fill($text.inverse) o($opacity.muted) wrap_text(true) max_lines(2) slot(author.role)
  #slot:quote.text sample("Lumen replaced three vendors and a week of design ops.") worst_case("Lumen replaced three separate vendors and a full week of tedious design operations.")
  #slot:author.name sample("Priya N.") worst_case("Priyanka Narayanaswamy")
  #slot:author.role sample("VP Brand, Northwind") worst_case("Vice President of Brand Marketing, Northwind Global")