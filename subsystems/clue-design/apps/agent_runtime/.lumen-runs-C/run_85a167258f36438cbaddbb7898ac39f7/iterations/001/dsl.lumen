page poster_revmotion size(1080,1080,px)
  artboard_rm al(v, x(s), y(s), g($space.section), pad(96)) p(0,0) s(fill,fill) fill($surface.brand) clip(true)
    header_rm al(h, x(s), y(c), g(12), pad(0)) p(0,0) s(888,hug)
      mark_rm al(h, x(c), y(c), pad(0)) p(0,0) s(44,44) fill($surface.inverse) rd($radius.badge)
        markt_rm text "RM" p(0,0) s(fill,hug) align(center) style($type.eyebrow) max_lines(1)
      logo_rm text "RevMotion" p(0,0) s(400,hug) style($type.label) fill($text.inverse) wrap_text(true) max_lines(1) slot(account.name)
    main_rm al(v, x(s), y(c), g($space.stack.default), pad(0)) p(0,0) s(888,fill)
      kicker_rm text "AI-NATIVE GTM · LIVE IN SF" p(0,0) s(888,hug) style($type.eyebrow) fill($text.inverse) wrap_text(true) max_lines(1) slot(campaign.eyebrow)
      headline_rm text "RevMotion '26" p(0,0) s(888,hug) style($type.headline) font_size($type.size.7xl) lh(1.04) fill($text.inverse) wrap_text(true) max_lines(2) slot(campaign.headline)
      subtitle_rm text "September 12–13 · San Francisco" p(0,0) s(820,hug) style($type.body) lh(1.4) fill($text.inverse) wrap_text(true) max_lines(2) slot(offer.primary_message)
    footer_rm al(h, x(s), y(c), g($space.md), pad(0)) p(0,0) s(888,hug)
      cta_rm al(h, x(c), y(c), pad(18,36)) p(0,0) s(340,72) fill($surface.inverse) rd($radius.button)
        cta_text_rm text "Save your seat" p(0,0) s(fill,hug) align(center) style($type.cta) max_lines(1) slot(campaign.cta)
  #slot:account.name sample("RevMotion") worst_case("RevMotion Events")
  #slot:campaign.eyebrow sample("AI-NATIVE GTM · LIVE IN SF") worst_case("AI-NATIVE GTM · LIVE IN SF")
  #slot:campaign.headline sample("RevMotion '26") worst_case("RevMotion '26")
  #slot:offer.primary_message sample("September 12–13 · San Francisco") worst_case("September 12–13 · San Francisco")
  #slot:campaign.cta sample("Save your seat") worst_case("Save your seat")