page pipeline_slide size(1920,1080,px)
  artboard al(v, x(s), y(s), g($space.section), pad(100,120)) p(0,0) s(fill,fill) fill($surface.page) clip(true)
    header al(h, x(s), y(c), g($space.sm), pad(0)) p(0,0) s(1680,hug)
      mark al(h, x(c), y(c), pad(0)) p(0,0) s(44,44) fill($surface.brand) rd($radius.badge)
        mark_glyph text "P" p(0,0) s(fill,hug) style($type.label) align(center) max_lines(1)
      eyebrow text "Q3 PIPELINE REVIEW" p(0,0) s(560,hug) style($type.eyebrow) wrap_text(true) max_lines(1) slot(campaign.eyebrow)
    main al(h, x(sb), y(c), g($space.section), pad(0)) p(0,0) s(1680,fill)
      hero al(v, x(s), y(c), g($space.stack.default), pad(0)) p(0,0) s(680,hug)
        hero_value text "4.2x" p(0,0) s(680,hug) style($type.stat) font_size($type.size.9xl) lh(1.0) wrap_text(true) max_lines(1)
        hero_label text "pipeline coverage on an $18M target" p(0,0) s(600,hug) style($type.subtitle) lh(1.25) wrap_text(true) max_lines(2) slot(campaign.hero_label)
        takeaway text "Coverage is healthy across every stage, with committed pipeline alone covering 59% of the $18M target." p(0,0) s(600,hug) style($type.body) lh(1.4) wrap_text(true) max_lines(3) slot(campaign.takeaway)
      chart al(v, x(s), y(c), g($space.stack.loose), pad(0)) p(0,0) s(900,hug)
        row1 al(v, x(s), g($space.stack.tight), pad(0)) p(0,0) s(900,hug)
          row1_name text "Discovery" p(0,0) s(900,hug) style($type.label) wrap_text(true) max_lines(1)
          row1_bar al(h, x(s), y(c), g($space.sm), pad(0)) p(0,0) s(900,hug)
            row1_fill r p(0,0) s(760,44) fill($surface.brand) rd($radius.badge)
            row1_value text "$28.4M" p(0,0) s(120,hug) style($type.subtitle) lh(1.0) wrap_text(true) max_lines(1)
        row2 al(v, x(s), g($space.stack.tight), pad(0)) p(0,0) s(900,hug)
          row2_name text "Evaluation" p(0,0) s(900,hug) style($type.label) wrap_text(true) max_lines(1)
          row2_bar al(h, x(s), y(c), g($space.sm), pad(0)) p(0,0) s(900,hug)
            row2_fill r p(0,0) s(562,44) fill($surface.brand) rd($radius.badge)
            row2_value text "$21.0M" p(0,0) s(120,hug) style($type.subtitle) lh(1.0) wrap_text(true) max_lines(1)
        row3 al(v, x(s), g($space.stack.tight), pad(0)) p(0,0) s(900,hug)
          row3_name text "Proposal" p(0,0) s(900,hug) style($type.label) wrap_text(true) max_lines(1)
          row3_bar al(h, x(s), y(c), g($space.sm), pad(0)) p(0,0) s(900,hug)
            row3_fill r p(0,0) s(417,44) fill($surface.brand) rd($radius.badge)
            row3_value text "$15.6M" p(0,0) s(120,hug) style($type.subtitle) lh(1.0) wrap_text(true) max_lines(1)
        row4 al(v, x(s), g($space.stack.tight), pad(0)) p(0,0) s(900,hug)
          row4_name text "Commit" p(0,0) s(900,hug) style($type.label) wrap_text(true) max_lines(1)
          row4_bar al(h, x(s), y(c), g($space.sm), pad(0)) p(0,0) s(900,hug)
            row4_fill r p(0,0) s(284,44) fill($surface.brand.subtle) rd($radius.badge)
            row4_value text "$10.6M" p(0,0) s(120,hug) style($type.subtitle) lh(1.0) wrap_text(true) max_lines(1)
  #slot:campaign.eyebrow sample("Q3 PIPELINE REVIEW") worst_case("Q3 PIPELINE REVIEW")
  #slot:campaign.hero_label sample("pipeline coverage on an $18M target") worst_case("pipeline coverage on an $18M target")
  #slot:campaign.takeaway sample("Coverage is healthy across every stage, with committed pipeline alone covering 59% of the $18M target.") worst_case("Coverage is healthy across every stage, with committed pipeline alone covering 59% of the $18M target.")