page onepager_a4 preset(a4,portrait)
  artboard al(v, x(s), g($space.stack.loose), pad(48)) p(0,0) s(fill,fill) fill($surface.page) clip(true)
    header al(h, x(sb), y(c), g($space.md), pad(0)) p(0,0) s(499,hug)
      brand al(h, x(s), y(c), g(10), pad(0)) p(0,0) s(280,hug)
        mark r p(0,0) s(32,32) fill($surface.brand) rd($radius.badge)
        logo text "Lumen" p(0,0) s(230,hug) style($type.label) wrap_text(true) max_lines(1) slot(account.name)
      tag text "Enablement leave-behind" p(0,0) s(209,hug) style($type.caption) wrap_text(true) max_lines(1) slot(account.tagline)
    main al(v, x(s), y(s), g($space.stack.loose), pad(0)) p(0,0) s(499,fill)
      hero al(v, x(s), g($space.stack.tight), pad(0)) p(0,0) s(499,hug)
        eyebrow text "PRODUCT ENABLEMENT" p(0,0) s(499,hug) style($type.eyebrow) wrap_text(true) max_lines(1) slot(campaign.eyebrow)
        headline text "How Lumen works in three steps." p(0,0) s(499,hug) style($type.headline) lh(1.12) wrap_text(true) max_lines(2) slot(campaign.headline)
        subtitle text "From a plain-language brief to an on-brand, production-ready design." p(0,0) s(499,hug) style($type.body.small) lh(1.4) wrap_text(true) max_lines(3) slot(offer.primary_message)
      list al(v, x(s), g($space.stack.default), pad(0)) p(0,0) s(499,hug)
        r1 al(h, x(s), y(s), g(20), pad(0)) p(0,0) s(499,hug)
          n1 al(h, x(c), y(c), pad(0)) p(0,0) s(56,56) fill($surface.brand.subtle) rd($radius.full)
            n1t text "1" p(0,0) s(fill,hug) style($type.subtitle) align(center) max_lines(1)
          t1 al(v, x(s), g(6), pad(0)) p(0,0) s(423,hug)
            t1t text "Brief it" p(0,0) s(423,hug) style($type.subtitle) lh(1.15) wrap_text(true) max_lines(1) slot(step.1.title)
            t1d text "Describe the account, offer, and goal in plain language." p(0,0) s(423,hug) style($type.body.small) lh(1.4) wrap_text(true) max_lines(2) slot(step.1.desc)
        r2 al(h, x(s), y(s), g(20), pad(0)) p(0,0) s(499,hug)
          n2 al(h, x(c), y(c), pad(0)) p(0,0) s(56,56) fill($surface.brand.subtle) rd($radius.full)
            n2t text "2" p(0,0) s(fill,hug) style($type.subtitle) align(center) max_lines(1)
          t2 al(v, x(s), g(6), pad(0)) p(0,0) s(423,hug)
            t2t text "It composes on-brand" p(0,0) s(423,hug) style($type.subtitle) lh(1.15) wrap_text(true) max_lines(1) slot(step.2.title)
            t2d text "Lumen assembles a layout using your brand kit and tokens." p(0,0) s(423,hug) style($type.body.small) lh(1.4) wrap_text(true) max_lines(2) slot(step.2.desc)
        r3 al(h, x(s), y(s), g(20), pad(0)) p(0,0) s(499,hug)
          n3 al(h, x(c), y(c), pad(0)) p(0,0) s(56,56) fill($surface.brand.subtle) rd($radius.full)
            n3t text "3" p(0,0) s(fill,hug) style($type.subtitle) align(center) max_lines(1)
          t3 al(v, x(s), g(6), pad(0)) p(0,0) s(423,hug)
            t3t text "Approve and export" p(0,0) s(423,hug) style($type.subtitle) lh(1.15) wrap_text(true) max_lines(1) slot(step.3.title)
            t3d text "Review the preview, tweak if needed, and export production-ready." p(0,0) s(423,hug) style($type.body.small) lh(1.4) wrap_text(true) max_lines(2) slot(step.3.desc)
    footer al(h, x(sb), y(c), g($space.md), pad(0)) p(0,0) s(499,hug)
      cta al(h, x(c), y(c), pad(16,32)) p(0,0) s(260,64) fill($surface.inverse) rd($radius.button)
        cta_text text "Book a Demo" p(0,0) s(fill,hug) style($type.cta) align(center) max_lines(1) slot(campaign.cta)
      contact text "lumen.ai/demo" p(0,0) s(219,hug) style($type.caption) wrap_text(true) max_lines(1) slot(account.contact)
  #slot:account.name sample("Lumen") worst_case("Lumen")
  #slot:account.tagline sample("Enablement leave-behind") worst_case("Enablement leave-behind")
  #slot:campaign.eyebrow sample("PRODUCT ENABLEMENT") worst_case("PRODUCT ENABLEMENT")
  #slot:campaign.headline sample("How Lumen works in three steps.") worst_case("How Lumen works in three steps.")
  #slot:offer.primary_message sample("From a plain-language brief to an on-brand, production-ready design.") worst_case("From a plain-language brief to an on-brand, production-ready design.")
  #slot:step.1.title sample("Brief it") worst_case("Brief it")
  #slot:step.1.desc sample("Describe the account, offer, and goal in plain language.") worst_case("Describe the account, offer, and goal in plain language.")
  #slot:step.2.title sample("It composes on-brand") worst_case("It composes on-brand")
  #slot:step.2.desc sample("Lumen assembles a layout using your brand kit and tokens.") worst_case("Lumen assembles a layout using your brand kit and tokens.")
  #slot:step.3.title sample("Approve and export") worst_case("Approve and export")
  #slot:step.3.desc sample("Review the preview, tweak if needed, and export production-ready.") worst_case("Review the preview, tweak if needed, and export production-ready.")
  #slot:campaign.cta sample("Book a Demo") worst_case("Book a Demo")
  #slot:account.contact sample("lumen.ai/demo") worst_case("lumen.ai/demo")