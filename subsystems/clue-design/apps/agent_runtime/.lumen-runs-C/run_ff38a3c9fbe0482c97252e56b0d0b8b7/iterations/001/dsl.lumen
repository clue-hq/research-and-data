page quote_card size(1080,1350,px)
  artboard al(v, x(s), y(s), g($space.section), pad(96)) p(0,0) s(fill,fill) fill($surface.brand) clip(true)
    header al(h, x(s), y(c), g(12), pad(0)) p(0,0) s(888,hug)
      eyebrow text "CUSTOMER STORY" p(0,0) s(600,hug) style($type.eyebrow) fill($text.inverse) o($opacity.muted) wrap_text(true) max_lines(1) slot(campaign.eyebrow)
    main al(v, x(s), y(c), g($space.stack.default), pad(0)) p(0,0) s(888,fill)
      quote_mark text "“" p(0,0) s(888,hug) style($type.display) font_size($type.size.9xl) fill($text.inverse) o($opacity.muted) lh(0.9) max_lines(1)
      quote text "Lumen replaced three vendors and a week of design ops." p(0,0) s(888,hug) style($type.headline) font_size($type.size.6xl) fill($text.inverse) lh(1.1) wrap_text(true) max_lines(5) slot(campaign.quote)
    footer al(v, x(s), y(c), g($space.stack.tight), pad(0)) p(0,0) s(888,hug)
      accent_rule r p(0,0) s(48,4) fill($accent.primary) rd($radius.full)
      attribution_name text "Priya N." p(0,0) s(888,hug) style($type.subtitle) fill($text.inverse) wrap_text(true) max_lines(1) slot(attribution.name)
      attribution_role text "VP Brand, Northwind" p(0,0) s(888,hug) style($type.body.small) fill($text.inverse) o($opacity.muted) wrap_text(true) max_lines(2) slot(attribution.role)
  #slot:campaign.eyebrow sample("CUSTOMER STORY") worst_case("CUSTOMER STORY")
  #slot:campaign.quote sample("Lumen replaced three vendors and a week of design ops.") worst_case("Lumen replaced three vendors and a full week of manual design operations work.")
  #slot:attribution.name sample("Priya N.") worst_case("Priyanka Natarajan")
  #slot:attribution.role sample("VP Brand, Northwind") worst_case("VP Brand & Creative, Northwind Industries")