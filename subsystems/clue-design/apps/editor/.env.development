# Committed dev defaults so a plain `npm run dev` matches this workspace's
# backend (scripts/dev-setup.sh runs the API on 127.0.0.1:8002). Without this,
# the editor falls back to :8000, the engine handshake can't reach /build-info,
# and the canvas silently degrades to server-only mode (uneditable).
#
# Shell env always wins over this file (dev-setup.sh frontend keeps working),
# and a personal .env.local overrides it too. Never put secrets here.
NEXT_PUBLIC_LUMEN_API_BASE_URL=http://127.0.0.1:8002
# The API's workspace seam is strict (design-integration Part II, O4): every request must
# carry X-Workspace-Id or it is refused with 401 workspace.header_required. Until Part IV
# brings real auth + a workspace picker, the dev harness pins one workspace here. It must
# match the API's LUMEN_DEV_WORKSPACE_ID (both default to ws_lumen_dev).
NEXT_PUBLIC_LUMEN_WORKSPACE_ID=ws_lumen_dev
