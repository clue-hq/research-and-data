# Lumen local development environment
#
# Copy to .env and fill in keys as needed. The setup script does this copy
# automatically if .env does not already exist.

# Backend API
LUMEN_API_DATABASE_PATH=apps/api/lumen-api.sqlite3
LUMEN_API_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Frontend editor
NEXT_PUBLIC_LUMEN_API_BASE_URL=http://127.0.0.1:8000

# Agent runtime
LUMEN_AGENT_MODEL=anthropic:claude-opus-4-6
LUMEN_AGENT_MAX_ITERATIONS=3
LUMEN_AGENT_PREVIEW_FORMAT=svg
LUMEN_AGENT_TRACE_DIR=.lumen-runs

# Required only for live DeepAgent / Anthropic calls.
ANTHROPIC_API_KEY=
