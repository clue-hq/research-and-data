# Lumen local development environment
#
# Copy to .env and fill in keys as needed. The setup script does this copy
# automatically if .env does not already exist.

# Backend API
LUMEN_API_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:3210,http://localhost:3210,http://127.0.0.1:3033,http://localhost:3033
# The design API's OWN origin. Every HTTP request path derives asset URLs from
# the incoming request and ignores this; it exists for the one consumer that has
# no request — the design deep agent's in-loop preview render, which runs in the
# FLEET WORKER and fetches each placed image from {origin}/asset-store/{digest}.
#
# Get this wrong and the failure is silent and expensive: the agent places the
# brand's real logo, its own preview screenshots show a broken image, the visual
# reviewer marks it, and the agent strips the imagery and reports that the
# supplied assets "did not render in the constrained preview". It looks exactly
# like a model that refuses to use images. Until 2026-08-20 this value was
# hardcoded in the agent runtime at port 8000 — dead since the API moved to 8010
# — and every generated page came out with zero image nodes.
#
# Set it on BOTH the design API process and the fleet worker process.
LUMEN_API_ORIGIN=http://127.0.0.1:8013

# --- Public address of PUBLISHED SITES (founder ruling R-F5-1) ---------------------------------
# Where a site the design subsystem publishes actually lives on the public internet. It is
# CONFIGURATION, never a constant compiled into the API or the editor: the URL the API reports
# and the marketer copies is built from these two keys and nothing else.
#
# Blank (the default, and the only correct value until the wildcard DNS + TLS exist) keeps the
# interim path routing: the site is served from the request's own origin at
# `/w/{workspace_id}/p/{slug}`, exactly as it always has been, so a developer with no DNS runs
# the whole flow unchanged. Set it to the wildcard host suffix once DNS + TLS exist and every
# site moves to `https://{workspace-handle}.{suffix}/{slug}`.
#
# Host mode needs BOTH halves — the suffix AND a workspace handle. A workspace with no handle
# keeps the interim path rather than being served from `https://.{suffix}`.
LUMEN_PUBLIC_PAGES_HOST_SUFFIX=
# The scheme those site hosts are served over. `https` unless a local wildcard host has no cert.
LUMEN_PUBLIC_PAGES_SCHEME=https
LUMEN_LOG_LEVEL=INFO
# Prebuilt lumen-api-helper binary; empty → `cargo run -p lumen-api-helper`. A prebuilt path
# does not rebuild itself: after any change under crates/, `cargo build -p lumen-api-helper
# --release` and restart (AGENTS.md §1).
# Production: leave this line out — the backend image sets it (deploy/check_prod_env.py refuses it).
LUMEN_CORE_HELPER=
LUMEN_CORE_HELPER_LOG=1
# Design agent turns are LEASED FLEET WORK since Part-II D5: POST /agent/turns (and the website
# twin) create a queued run and offer a `design_job`; a worker claims and executes it. With this
# on (the default) the API runs that worker on its own event loop, so `uvicorn lumen_api.main:app`
# stays one self-contained dev server. Set to 0 only when a detached platform fleet worker owns
# the drain (`clue_api.fleet_main` with CLUE_DESIGN_RUNTIME_ENABLED=1) — with neither, an offered
# turn sits `queued` forever.
LUMEN_EMBEDDED_FLEET_WORKER=1

# Brand-kit ingestion assistance. These are deployment defaults, intentionally not the intrinsic
# py_lumen_config defaults: deterministic library/test contexts stay off unless their launch env
# opts in. Both helpers use the same OpenRouter gateway. With no OPENROUTER_API_KEY they make zero
# network calls and ingestion continues through the existing deterministic extraction path.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LUMEN_INGESTION_VISION=1

# Clone-fidelity F3/F4, FOUNDER RULING R-X4 (2026-08-29): what a repair lineage resolves to when
# EVERY released member of it is marked broken — the harvested original AND every repair of it.
# One option, two values:
#
#   keep_flagged       (DEFAULT) the newest released repair stays selected and is reported as
#                      degraded and requiring review at every surface that already reports
#                      degraded (the pin warning, the picker, the recreate walk's report, the
#                      inspector card). The ruling in the founder's words: "never silently
#                      return to a known-broken original".
#   fallback_original  the pre-ruling behaviour, kept as a deliberate choice: the OLDEST approved
#                      member wins, which for a family that still holds its harvested original IS
#                      that original. Choose this only where seating the client's own broken band
#                      is preferable to seating a repair that was later measured broken.
#
# It changes ONLY that arm. A family with one healthy member still resolves to it under both
# values, and two released repairs that neither supersede each other still refuse under both.
# An unrecognized value fails loudly at startup rather than resolving to either.
LUMEN_DEGRADED_REPAIR_SELECTION=keep_flagged

# Brand Ad Assets lane (W2, flag-gated by LUMEN_BRAND_AD_ASSETS): the ad-library
# harvest fetches a client's published LinkedIn ads through Adyntel. Credentials
# are ENVIRONMENT-ONLY — never a code default, never logged, never committed
# (put real values in .env, NOT in this file). With either one blank, the
# provider refuses loudly at construction with a typed error naming both vars.
# ADYNTEL_EMAIL is the Adyntel ACCOUNT email (rides the request body with the
# key, per their auth scheme). Optional overrides: ADYNTEL_BASE_URL
# (default https://api.adyntel.com), ADYNTEL_TIMEOUT_S (default 60).
ADYNTEL_API_KEY=
ADYNTEL_EMAIL=
# The company-IDENTITY resolver (R3-A): answers "which LinkedIn page is this
# domain" from a source that is NOT the ad library, so the harvest is addressed
# by a verified page id. Blank is safe: the lane falls back to the fetch
# vendor's own domain resolution and says so honestly at the top level
# (`resolver_used: "ad_library_domain"`, `advertiser_verified: false`); the
# advertiser-name cross-check gates custody either way. One enrichment = one
# PDL credit. PDL_BASE_URL takes the host or the full enrichment endpoint —
# the resolver folds both.
PDL_API_KEY=
PDL_BASE_URL=https://api.peopledatalabs.com
PDL_TIMEOUT_S=30

# Brandfetch — target-account logo vendor (design subsystem). BRANDFETCH_API_KEY is the
# Brand API Bearer key (blank disables Brandfetch; official-site retrieval remains
# available). BRANDFETCH_CLIENT_ID is the PUBLIC Logo-API client id embedded in
# published-page <img> URLs for decorative third-party logos (blank = hotlink guidance
# omitted from web prompts). Both from https://developers.brandfetch.com/register.
BRANDFETCH_API_KEY=
BRANDFETCH_CLIENT_ID=
BRANDFETCH_API_BASE_URL=https://api.brandfetch.io
BRANDFETCH_TIMEOUT_S=20

# Stealth render backend (Scrapling-hardened Chromium) as the default for rendered website
# capture — paints WebGL heroes and defeats bot walls. Default ON; 0 falls back to the
# plain Playwright renderer.
LUMEN_RENDER_STEALTH=1
# QA renderers (page thumbnail, clone-review walk) present a normal Chrome User-Agent so
# Brandfetch's hotlinked logos render for review (founder decision 2026-09-02, plan D11).
# Default ON; 0 restores the headless UA. Never applied to the editor or to publish.
LUMEN_QA_RENDER_UA_OVERRIDE=1
# The logo ladder (target-logo scrape, second rung behind Brandfetch) fetches with a real Chrome
# TLS/HTTP fingerprint (curl_cffi impersonation, scrapling's engine), so Cloudflare-walled sites
# answer instead of 403 (founder decision 2026-09-02). Default ON; 0 restores plain httpx.
LUMEN_LADDER_IMPERSONATE_CHROME=1
# The lane's master switch (default off; routes are not even registered when off).
LUMEN_BRAND_AD_ASSETS=0
# Asset descriptions. Since design-quality Wave 1 (founder ruling R4) this is
# also the INTRINSIC py_lumen_config default, not just the deployment default:
# the agent picks images off the brand card's menu, and a menu of bare `img.N`
# rows tells it nothing (the last real harvest: 46 images, zero descriptions).
# Key presence is still the real gate — with no OPENROUTER_API_KEY the describer
# is inert and ingestion is byte-identical to describe-off.
#
# Every eligible image is analyzed, including vectors through their raster previews.
# Cache identity includes the original, preview, source evidence, model and prompt.
LUMEN_INGESTION_DESCRIBE=1
# The per-brand Creative Brief (design-brief plan, tier 2). ON in the durable
# recipe (quality-waves W1.6, founder ruling R2's companion): website ingestion
# always force-renders now, and a rendered re-extraction that publishes
# BRIEFLESS silently wastes the render and reopens the slice-4 walk's blocker 2
# — the UI Re-extract published a geometry-less, briefless v5 nobody wanted.
# The stage is still silent when the key is unconfigured (no call, no
# diagnostic, no `brand_kit_json.brief`); set 0 only when a deployment
# deliberately wants brief-free kits. The model must be vision-capable (the
# stage hands it the capture's screenshots).
LUMEN_INGESTION_BRIEF=1
# Optional model overrides; unset keeps py_lumen_config's existing model policy.
#
# DESCRIBE runs its OWN small, cheap vision model — deliberately NOT the
# brief/vision/assist model (those stay x-ai/grok-4.5). Live-probed 2026-08-23
# against the OpenRouter model list (250 image-input models; ranked by price,
# filtered to those advertising `structured_outputs`, since the describer sends
# a strict json_schema). Each candidate captioned three REAL kit assets from
# `apps/api/tests/fixtures/ingestion/insight_health_brand_kit.pdf` (a clinician
# photo, a phone mockup carrying the app icon, a business-card logo mockup)
# through the describer's own prompt + schema. Every price below is MEASURED —
# OpenRouter's own reported generation cost, averaged over that model's probe
# calls — NOT the list-price estimate the candidates were shortlisted by (the
# two differ by up to 2x, because list price has to assume a token count):
#   google/gemini-2.5-flash-lite   ~$0.00021/caption  ~2s   3/3 literal and
#                                    accurate over two passes; named the brand
#                                    mark and read the wordmark; declined to
#                                    guess rather than invent          <- default
#   bytedance-seed/seed-1.6-flash  ~$0.00013/caption  ~3s   accurate but
#                                    telegraphic ("Subject: … Colors: …") and
#                                    leaked Chinese into a usage field
#   qwen/qwen3.5-flash-02-23       ~$0.00049/caption 20-41s accurate; 2.4x the
#                                    price and 10x the latency (reasoning tokens)
#   mistralai/mistral-small-3.2-24b ~$0.000057/caption ~5s  CHEAPEST adequate-
#                                    looking, REJECTED: repeatably invented a
#                                    hand holding the phone and a home button
#                                    that is not there, and 429'd upstream
#   nex-agi/nex-n2-mini            ~$0.00005/caption        REJECTED: that price
#                                    holds only on the 2 assets it handled; on
#                                    the 3rd it ran away to a 65k-token
#                                    completion — 397s, $0.0066, unparseable
#   google/gemma-3-12b-it          ~$0.000042/caption       REJECTED: returns
#                                    null content under the strict json_schema
#   openai/gpt-5-nano              —                        REJECTED: HTTP 400,
#                                    refuses a top-level `array` schema
#   google/gemma-3-4b-it           —                        REJECTED: 429
#                                    rate-limited upstream on every attempt
# Measured cost per INGESTION at the W1.4 bound: 20 captions x $0.00021 ≈
# $0.0042 — against ~53 unbounded grok-4.5 captions ≈ $0.21 before this change.
# LUMEN_INGESTION_VISION_MODEL=
# LUMEN_INGESTION_DESCRIBE_MODEL=deepseek/deepseek-v4.1-flash
# LUMEN_INGESTION_BRIEF_MODEL=

# Frontend editor
NEXT_PUBLIC_LUMEN_API_BASE_URL=http://127.0.0.1:8000
# Workspace the editor talks to. The API refuses any request without X-Workspace-Id
# (401 workspace.header_required), so this must match the API's LUMEN_DEV_WORKSPACE_ID.
# Interim dev harness — Part IV replaces it with real auth + a workspace picker.
NEXT_PUBLIC_LUMEN_WORKSPACE_ID=ws_lumen_dev
# Canvas renderer: CanvasKit (Skia parity + real image pixels) is the default.
# Set to 0 to fall back to the legacy Konva canvas.
NEXT_PUBLIC_LUMEN_CANVASKIT=1

# Agent runtime
# OpenRouter is the SOLE gateway for every deep-agent LLM call — there is no
# native-provider fallback. LUMEN_AGENT_MODEL selects the model only, and must be
# an "openai:<openrouter-model-id>" value so the OpenAI-compatible client is used
# (e.g. openai:anthropic/claude-opus-4.8, openai:google/gemini-3-pro). Switching
# models = changing only this id.
LUMEN_AGENT_MODEL=openai:x-ai/grok-4.6
# Optional per-role model overrides (D10c). Each defaults to LUMEN_AGENT_MODEL
# when unset; same "openai:<id>" contract. Lets you e.g. pin the orchestrator's
# finalize call to a steadier model while keeping a cheaper author/reviewer.
LUMEN_AGENT_MODEL_ORCHESTRATOR=
LUMEN_AGENT_MODEL_AUTHOR=
LUMEN_AGENT_MODEL_REVIEWER=
LUMEN_AGENT_MAX_ITERATIONS=3
LUMEN_AGENT_PREVIEW_FORMAT=svg
# W-isolation: the deepagent runs in ONE isolated workspace. This root is also the
# run root (runs land at <workspace>/run_<id>) and where skills/knowledge are
# materialized. Unset → <repo>/.deepagent-workspace. LUMEN_AGENT_TRACE_DIR (below)
# is an explicit override that still wins for back-compat.
LUMEN_AGENT_WORKSPACE_ROOT=
# A design session's memory lives under <trace_dir>/sessions/<session_id>/ and its compaction
# history under <trace_dir>/conversation_history/<session_id>.md (media/ is shared). Erasure
# removes both with the session's runs, so point this at a path the worker really owns.
LUMEN_AGENT_TRACE_DIR=
# Optional: an output-token bound (D10a) applied to EVERY deep-agent LLM call
# via the one gateway — damage-limitation against runaway generation (e.g. a
# 65k-completion LengthFinishReasonError). Unset/blank → no bound (default);
# recommend 16000. A non-int or <=0 value fails loudly at startup.
LUMEN_AGENT_MAX_TOKENS=
# OpenRouter unified reasoning effort (low|medium|high) applied to EVERY
# deep-agent LLM call, whatever the model — one mechanism, no per-vendor special
# case. THE SHIPPED DEFAULT IS "medium" (ruling D1, 2026-08-26; the code default
# has been medium since the P3.2 gate finding, and this file was the last place
# still handing new deployments a blank). Live A/B on the Apollo POC: medium cut
# author-call latency from ~170s to 55–69s, and a no-reasoning run degrades into
# a myopic identical-call loop. Blank → NO reasoning field at all, i.e. the
# platform baseline — set it blank only if you specifically want that. A typo
# fails loudly at startup.
LUMEN_AGENT_REASONING=medium
# Optional (L1, cache locality): OpenRouter provider `sort` preference applied to
# EVERY deep-agent LLM call (latency|throughput|price). `sort` disables load-
# balancing and pins one provider replica, keeping the append-only ReAct prefix
# cache-warm (probe-proven 2/8 → 8/8 cache hits with sort="latency"). Default
# "latency"; blank/unset → no provider field on the request (pre-L1 behavior).
LUMEN_AGENT_PROVIDER_SORT=latency
# Optional (L3, straggler watchdog): per-request timeout in SECONDS for EVERY
# deep-agent LLM call. Installs timeout + max_retries=2 on the client; the SDK
# retries a timed-out request then propagates openai.APITimeoutError, which the
# harness finalizes as an honest failed turn. Kills the 60–97s stragglers; do NOT
# go below 60 (even fully-cached calls spike to ~28s). Default 60.0; blank/unset →
# no timeout/retry kwargs (today's behavior). A non-positive value fails loudly.
LUMEN_AGENT_LLM_TIMEOUT_S=60.0

# --- Fast-loop budgets (ruling D1, 2026-08-26: guidance, not gates) ---
# Only consulted when LUMEN_AGENT_FAST_LOOP is on. Two pairs, two jobs.
#
# The TARGET is what the agent is TOLD about. It rides the orchestrator prompt
# ("aim to finish inside 4 minutes") and the round-boundary BUDGET LEFT line.
# NOTHING cuts a run off at the target — crossing it is recorded in run_metrics
# as `budget_target_exceeded` and the run carries on. The local scene-family
# experiment targets 240s; the earlier 900s target and its repair evidence are
# documented in budget.py. Lowering the guidance must not silently cut off repairs.
LUMEN_AGENT_FAST_LOOP_TARGET_LLM_CALLS=20
LUMEN_AGENT_FAST_LOOP_TARGET_WALL_CLOCK_S=240.0
# The BACKSTOP is the unchanged circuit breaker for a hung or runaway run.
# It is the ONLY hard stop, it still finalizes checkpointed work
# gracefully, and the agent's prompt never mentions it — a healthy run never
# reaches it. A run that does lands `budget_exhausted` in run_metrics, which is
# an abnormal fact and reads differently from routine drift past the target.
# Must be >= its own target, or startup fails.
LUMEN_AGENT_FAST_LOOP_MAX_LLM_CALLS=90
LUMEN_AGENT_FAST_LOOP_WALL_CLOCK_S=1800.0
# Inner compile/fix iterations allowed inside ONE authoring round. Unchanged by
# D1: this one is still a real refusal, at the tool.
LUMEN_AGENT_FAST_LOOP_INNER_ITERATIONS=4

# OpenRouter gateway credentials for the deep-agent. BASE_URL is prefilled;
# API_KEY (your OpenRouter key) is required for any live agent call — without it
# the agent errors loudly at startup rather than falling back to a native provider.
LUMEN_AGENT_BASE_URL=https://openrouter.ai/api/v1
LUMEN_AGENT_API_KEY=

# Image generation (text-to-image). Routed through OpenRouter's
# OpenAI-compatible chat-completions API (raw HTTP). Without BASE_URL + API_KEY
# set, /assets/generate?provider=image-gen-v1 returns a clean 503 and no image
# is produced.
#
# IMAGE_MODEL_ID must be a model OpenRouter serves on the CHAT-COMPLETIONS image
# modality. That is a narrower list than "OpenRouter image models": OpenRouter
# runs two endpoints with different catalogues, and this provider uses the first.
#
#   chat-completions (ours)  GET /api/v1/models?output_modalities=image
#   dedicated Image API      GET /api/v1/images/models
#
# TRAP (cost the Apollo POC a restart to diagnose, 2026-08-25): `openai/gpt-image-2`
# is REAL, but it is Image-API-only. On this path it fails with
#   404 "No endpoints found that support the requested output modalities: image, text"
# which reads like an outage and is actually a config mistake. Same for
# `openai/gpt-image-1` and `openai/gpt-image-1-mini`.
#
# Verified working on this path (2026-08-26): openai/gpt-5.4-image-2 (the default
# if you leave this blank), openai/gpt-5-image, openai/gpt-5-image-mini,
# google/gemini-3-pro-image, google/gemini-2.5-flash-image.
#
# CHAT-PATH ALTERNATIVE (verified 2026-08-26): IMAGE_MODEL_ID=openai/gpt-5.4-image-2
# with IMAGE_MODEL_API_STYLE=chat (or unset). The active default below is the
# founder-ordered Images-endpoint configuration (2026-08-23), workable now that
# IMAGE_MODEL_API_STYLE=images selects the dedicated transport.
# is produced — and the design lanes fall back to the grey stub placeholder,
# which is what "every generated page has no imagery" looked like before
# 2026-08-20. These are needed by BOTH the design API and the fleet worker that
# runs the design deepagent; the agent runtime is where web/scene imagery is
# actually generated.
#
# IMAGE_MODEL_ID must be a real OpenRouter model whose architecture lists
# `image` in output_modalities (11 did on 2026-08-20; verify, never guess).
# Live-probed 2026-08-20 with a 16:9 hero prompt:
#   google/gemini-3.1-flash-image       1376x768  ~14s  ~$0.068/image  <- default
#   google/gemini-3.1-flash-lite-image  1376x768   ~5s  ~$0.034/image  (looser craft)
#   google/gemini-3-pro-image           1376x768  ~27s  ~$0.14/image
#   google/gemini-2.5-flash-image       1024x1024  ~7s  ~$0.039/image  (ignores aspect)
#   openai/gpt-5-image-mini             1024x1024 ~51s  cheap but slow, ignores aspect
# Honoring the aspect hint is the deciding property: a page's hero band is not
# square, and a square image in a 16:9 frame is cropped to nonsense.
#
# FOUNDER OVERRIDE 2026-08-23: openai/gpt-image-2 is the deployment default by
# founder order. It was NOT part of the 2026-08-20 probe above, so its aspect-
# hint behavior and its availability through the chat-completions image
# modality are UNVERIFIED — verify both on the first live generation (a failure
# degrades loudly to the grey stub with a LUMA0710/0711 diagnostic, never
# silently).
#
# UPDATE 2026-08-23 (founder-supplied OpenRouter API reference): gpt-image-2 does
# NOT answer the chat-completions image modality at all. It takes OpenRouter's
# DEDICATED Images endpoint — POST https://openrouter.ai/api/v1/images with a
# top-level `prompt`, `aspect_ratio`, `quality`, `input_references`, and a base64
# `data[*].b64_json` response. `IMAGE_MODEL_API_STYLE=images` selects that
# transport; leave it unset (=chat) for the Gemini-class models probed above.
#
# What that endpoint's reference pins, and what it does NOT:
#   aspect_ratio  enum 1:1 3:2 2:3 4:3 3:4 16:9 9:16 21:9 auto  (STRUCTURED —
#                 caller ratios outside the enum are snapped to the nearest)
#   quality       enum auto|low|medium|high                     (we send high)
#   background    enum auto|OPAQUE — there is NO "transparent" member, so a
#                 transparent request can only be asked for in prose and this
#                 model CANNOT honor it structurally. Founder rule: always send
#                 "auto" (which is what both founder sample bodies carry).
#   n             1-10 (omitted; we want exactly one image)
#   input_references 0-16 (our attachment cap is 4)
# Reference bytes are sent as data URLs. Model identity participates in generation
# cache keys and provenance, so selecting a new model does not reuse old-model output.
# Selected 2026-09-16: GPT Image 2.5 Flare, using this same Images API transport.
IMAGE_MODEL_BASE_URL=https://openrouter.ai/api/v1
IMAGE_MODEL_API_KEY=
IMAGE_MODEL_ID=openai/gpt-image-2.5-flare
IMAGE_MODEL_API_STYLE=images
# Optional:
# IMAGE_MODEL_API_STYLE=chat             # chat-completions image modality (default)
# IMAGE_MODEL_PROVIDER_ID=image-gen-v1   # provider id the agent/editor target
# gpt-image-2 at quality=high measured 67-75s/image on the 2026-08-23 live
# probe — the old 60s suggestion times out EVERY call and burns all 3 retries
# per generation. 240 gives headroom; gemini-class chat models (~14s) are
# unaffected by a generous ceiling.
IMAGE_MODEL_TIMEOUT_S=240
# IMAGE_MODEL_MAX_RETRIES=2
# IMAGE_MODEL_HTTP_REFERER=              # OpenRouter attribution (optional)
# IMAGE_MODEL_APP_TITLE=Lumen            # OpenRouter attribution (optional)

# G7 — the Tailwind v4 BROWSER runtime the agent runtime inlines into every
# preview screenshot. An editor-mode render carries theme tokens and font-faces
# but NO utility rules, so this file is what compiles the page's layout classes;
# without it a preview is the page with its whole layout layer deleted, and the
# visual reviewer grades that. Leave UNSET in development: the runtime finds
# `apps/editor/public/vendor/tailwind-browser.js` (written by
# `scripts/vendor_tailwind_runtime.sh`, run from the editor's predev/prebuild),
# and failing that `apps/editor/node_modules/@tailwindcss/browser/dist/
# index.global.js`. Set it only in an image that ships the file elsewhere — a
# path that does not exist resolves to "missing" rather than falling back.
# LUMEN_TAILWIND_RUNTIME=

# Puck sites (Wave 2): where site-kit's built files are (dist/validate-site.mjs, build-catalog.mjs,
# render-browser.js). Empty = the checkout's apps/frontend/packages/site-kit/dist, which
# `npm run build -w @clue/site-kit` (run from apps/frontend) writes and the backend image builds.
LUMEN_SITE_KIT_DIST=

# Puck sites (Wave 2): run the hardened render page with Chromium's own sandbox. Default ON, which
# is right on a Mac (dev stacks). Containers cannot give Chromium its sandbox (Docker's default
# seccomp profile), so the backend IMAGE sets 0 and a production env file must leave this line out
# (deploy/check_prod_env.py refuses it). Why, and how to upgrade: docs/specs/2026-10-14-site-render-chromium-sandbox-decision.md
LUMEN_SITE_RENDER_CHROMIUM_SANDBOX=1
# Live Puck sites (publishing live sites, phase 1): the workspaces whose published sites run their
# JavaScript in the visitor's browser (comma-separated workspace ids; `*` = every workspace, what
# production sets). Empty = every site publishes static, exactly as before.
# docs/superpowers/specs/2026-10-15-publishing-live-sites-design.md
LUMEN_SITE_LIVE_WORKSPACES=

# --- Design-subsystem settings recorded for env parity (2026-09-08 audit) --------------------
# Every py_lumen_config field that had no line in this file, at its CODE default (no behaviour change).
# A commented line means the default is unset/None. Descriptions: packages/py-lumen-config/py_lumen_config/config.py.
# LUMEN_ASSET_STORE_ROOT=   (default: unset)
LUMEN_ASSET_MAX_BYTES=10485760
# Production: leave this line out — the backend image sets it (deploy/check_prod_env.py refuses it).
LUMEN_FONT_LIBRARY_MANIFEST_PATH=apps/api/font-library/manifest.json
# LUMEN_CORE_HELPER=   (default: unset)
LUMEN_DESIGN_REAPER_INTERVAL_S=300.0
LUMEN_FRAGMENT_MINT_CAP=40
# Total per visible/dormant pool for multipage library captures; fair page allocation.
# Legacy single-page jobs retain LUMEN_FRAGMENT_MINT_CAP.
LUMEN_SITE_LIBRARY_FRAGMENT_MINT_CAP=240
IMAGE_MODEL_PROVIDER_ID=image-gen-v1
IMAGE_MODEL_MAX_RETRIES=2
# IMAGE_MODEL_HTTP_REFERER=   (default: unset)
# IMAGE_MODEL_APP_TITLE=   (default: unset)
# CLUE_OPENROUTER_API_KEY=   (default: unset)
LUMEN_INGESTION_ASSIST=0
LUMEN_INGESTION_ASSIST_MODEL=x-ai/grok-4.5
LUMEN_INGESTION_VISION_MODEL=x-ai/grok-4.5
LUMEN_INGESTION_DESCRIBE_MODEL=deepseek/deepseek-v4.1-flash
LUMEN_INGESTION_BRIEF_MODEL=x-ai/grok-4.7
LUMEN_INGESTION_BRIEF_REASONING=medium
ADYNTEL_BASE_URL=https://api.adyntel.com
ADYNTEL_TIMEOUT_S=60.0
LUMEN_AD_DNA_MODEL=deepseek/deepseek-v4.1-flash
LUMEN_ASSET_EMBEDDINGS=1
LUMEN_ASSET_EMBEDDING_MODEL_DIR=/srv/clue/models/clip-vit-base-patch32-onnx
# LUMEN_AGENT_ASSET_STORE=   (default: unset)
# LUMEN_AGENT_FALLBACK_MODEL=   (default: unset)
LUMEN_AGENT_AUTO_DEFAULTS=0
LUMEN_AGENT_FAST_LOOP=1
# Scene-only skill catalog: legacy or candidate. Isolate workspaces per bundle.
LUMEN_AGENT_SCENE_SKILL_BUNDLE=candidate
# Candidate viewing profile; empty disables the numeric floor (code default).
# compact-feed-v1: 8px; legible-feed-v1: 10px nominal em at 360px display width.
# Selected for the local feed-ad evaluation; not a print/general-scene rule.
LUMEN_AGENT_SCENE_REVIEW_PROFILE=legible-feed-v1
# One scene agent with no delegation; requires candidate bundle + FAST_LOOP=1.
LUMEN_AGENT_SCENE_SOLO=1
LUMEN_AGENT_SCENE_REVIEWER=0
LUMEN_AGENT_WEB_FAST_LOOP=0
LUMEN_AGENT_WEB_REVIEWER=0
# LUMEN_AGENT_FAST_LOOP_PINNED_KNOWLEDGE=   (default: unset)
LUMEN_AGENT_AUTOFIX_MAX_PASSES=2
# ANTHROPIC_API_KEY=   (default: unset)
# Web design deepagent loop shape (see py_lumen_config; D-F7 + solo ruling 2026-09-04).
# SOLO=1: ONE agent — director, designer, and customer-eyes judge in a single loop; both
# web subagents quarantined; merged solo prompt; plan.md is the working memory. 0 restores
# the trio (orchestrator + author + reviewer). The two flags below only matter at SOLO=0:
# WEB_FAST_LOOP=1 quarantines just the reviewer (self-review, same rubric);
# WEB_REVIEWER=1 puts the reviewer back without leaving the fast loop.
LUMEN_AGENT_WEB_SOLO=1

# Website-agent context clearing (founder decisions 2026-10-06): before each model call, old
# preview screenshots (superseded by a newer render) and section searches/inspections from
# before plan.md become one-line stubs. Saved history is untouched. 0 sends everything again.
LUMEN_AGENT_WEB_CONTEXT_CLEARING=1

# Non-OpenAI design-agent models (grok-4.6 default) over OpenRouter chat-completions instead
# of the /responses bridge (2026-09-04: a 136s grok generation on /responses died mid-stream
# with "Auth context expired" and took a six-minute run with it). 0 restores /responses.
LUMEN_AGENT_OPENROUTER_CHAT_COMPLETIONS=1

# Continuous per-image enrichment; limits simultaneous requests, never coverage.
# Shared across asset-analysis jobs using the same provider credential via CLUE_REDIS_URL.
LUMEN_INGESTION_DESCRIBE_CONCURRENCY=40
# Output cap per described asset (max_tokens; a multi-asset call multiplies it, ceiling 131072).
# Measured 2026-09-29: legitimate analyses median ~4.5k / p99 ~15k output tokens; runaways hit 131072.
LUMEN_INGESTION_DESCRIBE_MAX_TOKENS_PER_ASSET=32768
# On-demand ingestion: one coordinator, four image workers with ten slots each.
# These processes stop after idle; the lightweight controller remains available.
LUMEN_INGESTION_POOL_WORKERS=4
LUMEN_INGESTION_WORKER_CONCURRENCY=10
LUMEN_INGESTION_POOL_IDLE_SECONDS=60
LUMEN_INGESTION_POOL_POLL_SECONDS=2
# The ingestion CONTROLLER's own database URL. Empty = CLUE_DATABASE_URL. The worker VM sets the
# direct Postgres URL here: the controller holds a session advisory lock, which PgBouncer's
# transaction pooling would break; its children stay on CLUE_DATABASE_URL (PgBouncer).
LUMEN_INGESTION_CONTROLLER_DATABASE_URL=

# Puck sites (Wave 2 Contract 4): the secret that signs the editor's 10-minute links to an
# agent-written section module. Set it in every environment that runs the design API; empty =
# section links are refused (503 site_section_links.unconfigured). In production (auth environment
# "production") the design API refuses to START without one of at least 32 characters
# (`openssl rand -hex 32`; review finding S7-4).
CLUE_SITE_SECTION_LINK_SECRET=
