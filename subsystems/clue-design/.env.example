# Lumen local development environment
#
# Copy to .env and fill in keys as needed. The setup script does this copy
# automatically if .env does not already exist.

# Backend API
LUMEN_API_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
LUMEN_LOG_LEVEL=INFO
LUMEN_CORE_HELPER_LOG=1
# Design agent turns are LEASED FLEET WORK since Part-II D5: POST /agent/turns (and the website
# twin) create a queued run and offer a `design_job`; a worker claims and executes it. With this
# on (the default) the API runs that worker on its own event loop, so `uvicorn lumen_api.main:app`
# stays one self-contained dev server. Set to 0 only when a detached platform fleet worker owns
# the drain (`clue_api.fleet_main` with CLUE_DESIGN_RUNTIME_ENABLED=1) — with neither, an offered
# turn sits `queued` forever.
LUMEN_EMBEDDED_FLEET_WORKER=1

# Brand-kit ingestion assistance. These are deployment defaults, intentionally not the intrinsic
# py_lumen_config defaults: deterministic library/test contexts stay off unless their launch env
# opts in. Both helpers use the same OpenRouter gateway. With no OPENROUTER_API_KEY they make zero
# network calls and ingestion continues through the existing deterministic extraction path.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LUMEN_INGESTION_VISION=1
LUMEN_INGESTION_DESCRIBE=1
# The per-brand Creative Brief (design-brief plan, tier 2). OFF here by default:
# the stage is silent when unconfigured — no call, no diagnostic, no
# `brand_kit_json.brief` — so turning it on is a deliberate deployment choice.
# The model must be vision-capable (the stage hands it the capture's screenshots).
LUMEN_INGESTION_BRIEF=0
# Optional model overrides; unset keeps py_lumen_config's existing model policy.
# LUMEN_INGESTION_VISION_MODEL=
# LUMEN_INGESTION_DESCRIBE_MODEL=
# LUMEN_INGESTION_BRIEF_MODEL=

# Frontend editor
NEXT_PUBLIC_LUMEN_API_BASE_URL=http://127.0.0.1:8000
# Workspace the editor talks to. The API refuses any request without X-Workspace-Id
# (401 workspace.header_required), so this must match the API's LUMEN_DEV_WORKSPACE_ID.
# Interim dev harness — Part IV replaces it with real auth + a workspace picker.
NEXT_PUBLIC_LUMEN_WORKSPACE_ID=ws_lumen_dev
# Canvas renderer: CanvasKit (Skia parity + real image pixels) is the default.
# Set to 0 to fall back to the legacy Konva canvas.
NEXT_PUBLIC_LUMEN_CANVASKIT=1

# Agent runtime
# OpenRouter is the SOLE gateway for every deep-agent LLM call — there is no
# native-provider fallback. LUMEN_AGENT_MODEL selects the model only, and must be
# an "openai:<openrouter-model-id>" value so the OpenAI-compatible client is used
# (e.g. openai:anthropic/claude-opus-4.8, openai:google/gemini-3-pro). Switching
# models = changing only this id.
LUMEN_AGENT_MODEL=openai:anthropic/claude-opus-4.8
# Optional per-role model overrides (D10c). Each defaults to LUMEN_AGENT_MODEL
# when unset; same "openai:<id>" contract. Lets you e.g. pin the orchestrator's
# finalize call to a steadier model while keeping a cheaper author/reviewer.
LUMEN_AGENT_MODEL_ORCHESTRATOR=
LUMEN_AGENT_MODEL_AUTHOR=
LUMEN_AGENT_MODEL_REVIEWER=
LUMEN_AGENT_MAX_ITERATIONS=3
LUMEN_AGENT_PREVIEW_FORMAT=svg
# W-isolation: the deepagent runs in ONE isolated workspace. This root is also the
# run root (runs land at <workspace>/run_<id>) and where skills/knowledge are
# materialized. Unset → <repo>/.deepagent-workspace. LUMEN_AGENT_TRACE_DIR (below)
# is an explicit override that still wins for back-compat.
LUMEN_AGENT_WORKSPACE_ROOT=
LUMEN_AGENT_TRACE_DIR=
# Optional: an output-token bound (D10a) applied to EVERY deep-agent LLM call
# via the one gateway — damage-limitation against runaway generation (e.g. a
# 65k-completion LengthFinishReasonError). Unset/blank → no bound (default);
# recommend 16000. A non-int or <=0 value fails loudly at startup.
LUMEN_AGENT_MAX_TOKENS=
# Optional: OpenRouter unified reasoning effort (low|medium|high) applied to
# EVERY deep-agent LLM call, whatever the model — one mechanism, no per-vendor
# special case. Unset/blank → no reasoning field (provider default: no
# extended thinking). A typo fails loudly at startup.
LUMEN_AGENT_REASONING=
# Optional (L1, cache locality): OpenRouter provider `sort` preference applied to
# EVERY deep-agent LLM call (latency|throughput|price). `sort` disables load-
# balancing and pins one provider replica, keeping the append-only ReAct prefix
# cache-warm (probe-proven 2/8 → 8/8 cache hits with sort="latency"). Default
# "latency"; blank/unset → no provider field on the request (pre-L1 behavior).
LUMEN_AGENT_PROVIDER_SORT=latency
# Optional (L3, straggler watchdog): per-request timeout in SECONDS for EVERY
# deep-agent LLM call. Installs timeout + max_retries=2 on the client; the SDK
# retries a timed-out request then propagates openai.APITimeoutError, which the
# harness finalizes as an honest failed turn. Kills the 60–97s stragglers; do NOT
# go below 60 (even fully-cached calls spike to ~28s). Default 60.0; blank/unset →
# no timeout/retry kwargs (today's behavior). A non-positive value fails loudly.
LUMEN_AGENT_LLM_TIMEOUT_S=60.0

# OpenRouter gateway credentials for the deep-agent. BASE_URL is prefilled;
# API_KEY (your OpenRouter key) is required for any live agent call — without it
# the agent errors loudly at startup rather than falling back to a native provider.
LUMEN_AGENT_BASE_URL=https://openrouter.ai/api/v1
LUMEN_AGENT_API_KEY=

# Image generation (text-to-image). Routed through OpenRouter's
# OpenAI-compatible chat-completions API (raw HTTP). Without BASE_URL + API_KEY
# set, /assets/generate?provider=image-gen-v1 returns a clean 503 and no image
# is produced. IMAGE_MODEL_ID must be a real OpenRouter image-capable model id.
IMAGE_MODEL_BASE_URL=https://openrouter.ai/api/v1
IMAGE_MODEL_API_KEY=
IMAGE_MODEL_ID=
# Optional:
# IMAGE_MODEL_PROVIDER_ID=image-gen-v1   # provider id the agent/editor target
# IMAGE_MODEL_TIMEOUT_S=60
# IMAGE_MODEL_MAX_RETRIES=2
# IMAGE_MODEL_HTTP_REFERER=              # OpenRouter attribution (optional)
# IMAGE_MODEL_APP_TITLE=Lumen            # OpenRouter attribution (optional)

# G7 — the Tailwind v4 BROWSER runtime the agent runtime inlines into every
# preview screenshot. An editor-mode render carries theme tokens and font-faces
# but NO utility rules, so this file is what compiles the page's layout classes;
# without it a preview is the page with its whole layout layer deleted, and the
# visual reviewer grades that. Leave UNSET in development: the runtime finds
# `apps/editor/public/vendor/tailwind-browser.js` (written by
# `scripts/vendor_tailwind_runtime.sh`, run from the editor's predev/prebuild),
# and failing that `apps/editor/node_modules/@tailwindcss/browser/dist/
# index.global.js`. Set it only in an image that ships the file elsewhere — a
# path that does not exist resolves to "missing" rather than falling back.
# LUMEN_TAILWIND_RUNTIME=
