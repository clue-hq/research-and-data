    "content": "{\"sections\":[{\"key\":\"contact_insights\",\"empty\":false,\"items\":[{\"h2\":\"Vari Kaur leads growth marketing and holds ABM certifications\",\"body\":[{\"text\":\"Vari Kaur is listed as Head of Growth Marketing, and her certifications include Account-Based Go-to-Market (GTM) Certification and ABM Advanced Certification from Demandbase. (zaf-024, zaf-033)\",\"claimIds\":[\"zaf-024\",\"zaf-033\"]},{\"text\":\"What it means for us: Lead with Clue's ABM workflows and show how they can support the ABM program she is building. (zaf-033, zaf-090)\",\"claimIds\":[\"zaf-033\",\"zaf-090\"]}],\"contactRefs\":[{\"name\":\"Vari Kaur\"}],\"priority\":1},{\"h2\":\"Nick Fisher shared a 96% proof-of-value finding\",\"body\":[{\"text\":\"In a LinkedIn article, Nick Fisher wrote, \\\"we revealed how 96% of vulnerabilities didn’t require patching and can be mitigated using existing controls.\\\" (zaf-159)\",\"claimIds\":[\"zaf-159\"]},{\"text\":\"What it means for us: Connect Clue's account research and personalized campaign output to the same focus on measurable proof and existing systems. (zaf-159, zaf-089)\",\"claimIds\":[\"zaf-159\",\"zaf-089\"]}],\"contactRefs\":[{\"name\":\"Nick Fisher\"}],\"priority\":1},{\"h2\":\"Sanaz Yashar identified operator capacity as cybersecurity's biggest pain\",\"body\":[{\"text\":\"Sanaz Yashar said, \\\"And the biggest pain of cybersecurity when you come from the offensive war to the defensive war, the biggest pain is we don't have enough operators to operate all the different vulnerabilities.\\\" (zaf-095)\",\"claimIds\":[\"zaf-095\"]},{\"text\":\"What it means for us: Emphasize how Clue can reduce manual account research and campaign execution work for a stretched security company team. (zaf-095, zaf-129)\",\"claimIds\":[\"zaf-095\",\"zaf-129\"]}],\"contactRefs\":[{\"name\":\"Sanaz Yashar\"}],\"priority\":1},{\"h2\":\"Ben Seri is Co-Founder & CTO with prior VP of Research experience at Armis\",\"body\":[{\"text\":\"Ben Seri is listed as Co-Founder & CTO at Zafran Security and previously held the title VP of Research at Armis. (zaf-063, zaf-069)\",\"claimIds\":[\"zaf-063\",\"zaf-069\"]},{\"text\":\"What it means for us: Give Ben technical detail on how Clue's research connects account signals, buying committees, and cited sources. (zaf-064, zaf-069)\",\"claimIds\":[\"zaf-064\",\"zaf-069\"]}],\"contactRefs\":[{\"name\":\"Ben Seri\"}],\"priority\":2},{\"h2\":\"Tom Anthony moved into SVP, Global Sales after enterprise sales leadership at Okta\",\"body\":[{\"text\":\"Tom Anthony is listed as SVP, Global Sales at Zafran Security, after holding enterprise sales leadership roles at Okta. (zaf-072, zaf-078)\",\"claimIds\":[\"zaf-072\",\"zaf-078\"]},{\"text\":\"What it means for us: Position Clue around supporting coordinated pipeline generation across sales and marketing. (zaf-073, zaf-089, zaf-166)\",\"claimIds\":[\"zaf-073\",\"zaf-089\",\"zaf-166\"]}],\"contactRefs\":[{\"name\":\"Tom Anthony\"}],\"priority\":2}]}]}",
