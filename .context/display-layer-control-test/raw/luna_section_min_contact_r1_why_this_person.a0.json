    "content": "{\"sections\":[{\"key\":\"why_this_person\",\"empty\":false,\"items\":[{\"h2\":\"VP Marketing and economic buyer while Zafran builds ABM from scratch\",\"body\":[{\"text\":\"Nick is VP of Marketing at Zafran Security and is tagged as an economic buyer.\",\"claimIds\":[\"zaf-038\",\"zaf-039\",\"zaf-043\"]},{\"text\":\"Zafran's ABM program is being built from scratch, with a Senior Manager, ABM & Integrated Campaigns role responsible for the motion.\",\"claimIds\":[\"zaf-090\"]}],\"sendLine\":\"In your email: Acknowledge that you're building ABM from scratch and position Clue as a way to help execute account research and coordinated plays.\",\"contactRefs\":[{\"name\":\"Nick Fisher\"}],\"priority\":1},{\"h2\":\"His Zafran POV centers on real risk exposure, not patching everything\",\"body\":[{\"text\":\"Nick authored the LinkedIn article “Why I joined Zafran Security,” which describes his rationale for joining and market/problem framing.\",\"claimIds\":[\"zaf-158\"]},{\"text\":\"In that article, he wrote, “we revealed how 96% of vulnerabilities didn’t require patching and can be mitigated using existing controls.”\",\"claimIds\":[\"zaf-159\"]}],\"sendLine\":\"In your email: Connect Clue's account-level research to the risk-exposure story behind “Why I joined Zafran Security.”\",\"contactRefs\":[{\"name\":\"Nick Fisher\"}],\"priority\":1},{\"h2\":\"A senior B2B marketer with product marketing and scale experience\",\"body\":[{\"text\":\"His career history includes VP of Marketing at Zafran Security, Vice President Product Marketing at Sysdig, and Senior Director Product Marketing at Okta.\",\"claimIds\":[\"zaf-045\"]},{\"text\":\"He describes himself as a “Full-stack B2B marketing leader / storyteller with experience building teams for early stage growth and post-IPO scale.”\",\"claimIds\":[\"zaf-044\"]}],\"sendLine\":\"In the platform: Prioritize a senior-marketer brief spanning team building, product marketing, and scale.\",\"contactRefs\":[{\"name\":\"Nick Fisher\"}],\"priority\":1}]}]}",
