{
  "name": "clue-front-end",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "scripts": {
    "assets:sync": "node scripts/sync-brand-assets.mjs",
    "design-system:build": "npm run build --workspace @clue/design-system",
    "predev": "node scripts/copy-design-vendor.mjs",
    "dev": "next dev --hostname localhost",
    "prebuild": "node scripts/copy-design-vendor.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "pretest": "node scripts/copy-design-vendor.mjs",
    "test": "find src -name '*.test.ts' -print0 | xargs -0 tsx --test",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@clerk/nextjs": "^7.7.1",
    "@clue/design-system": "*",
    "@clue/site-kit": "*",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/simple-icons": "^1.2.92",
    "@lexical/history": "0.48.0",
    "@lexical/html": "0.48.0",
    "@lexical/link": "0.48.0",
    "@lexical/list": "0.48.0",
    "@lexical/rich-text": "0.48.0",
    "@lexical/selection": "0.48.0",
    "@lezer/highlight": "^1.2.3",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@mdxeditor/editor": "4.2.5",
    "@mdxeditor/gurx": "1.2.4",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@tailwindcss/browser": "^4.3.3",
    "ai": "^7.0.48",
    "canvaskit-wasm": "0.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lexical": "0.48.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.1",
    "slate": "^0.126.0",
    "slate-history": "^0.113.1",
