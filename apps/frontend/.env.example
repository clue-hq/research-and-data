# Copy to .env.local and uncomment to point the accounts flow at a real backend.
# Both variables are read on the Next.js server only — never expose either as
# NEXT_PUBLIC_*, because the workspace below is the tenancy boundary.
#
# Leave them commented out to use the validated local fixture repositories,
# which is the default for frontend-only work.

# The backend origin serving the read layer at /frontend/v1. Setting this flips
# the accounts, account-detail and contacts screens from fixtures to HTTP.
# Deliberately scoped to the accounts flow: the projects/home screens are pinned
# to fixtures until phase 2 gives them a backend surface of their own.
# CLUE_ACCOUNTS_API_BASE_URL=http://127.0.0.1:8000

# Every /frontend/v1 data request is workspace-scoped through the
# X-Workspace-Id header; the backend answers 401 UNAUTHORIZED without it. This
# is the MVP stand-in for a real session/tenant surface and is required
# whenever CLUE_ACCOUNTS_API_BASE_URL is set.
# CLUE_WORKSPACE_ID=ws_local_dev
