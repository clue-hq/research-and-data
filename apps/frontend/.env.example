# The Accounts/Contacts repositories call this backend through the authenticated
# Clue principal seam; browser-originated API calls use the same-origin
# `/api/clue` BFF. The selected workspace comes from the HttpOnly session cookie
# and Clue membership — never from a build-time environment variable or
# browser-authored header. The optional local instance selector below
# (CLUE_LOCAL_WORKSPACE_ID/NAME) still requires that membership.
#
# ARV2 D4: `CLUE_ACCOUNTS_FIXTURE_MODE` is the one explicit switch that serves the
# design build's account fixtures instead of the backend. It is opt-in and never a
# fallback: with it unset or not exactly "true", the live path is used and refuses
# loudly rather than quietly showing fixture data.
CLUE_ACCOUNTS_FIXTURE_MODE=false
#
# `CLUE_API_BASE_URL` is server-only; do not prefix it with `NEXT_PUBLIC_`.
# `/accounts` requires authentication to be enabled and fully configured.
CLUE_AUTH_ENABLED=false
CLUE_API_BASE_URL=http://127.0.0.1:8023
CLUE_APP_ORIGIN=http://localhost:3033
# Optional in the frontend process; when present it is preflight-checked against CLUE_APP_ORIGIN.
CLUE_AUTH_CLERK_AUTHORIZED_PARTIES=http://localhost:3020,http://127.0.0.1:3020,http://localhost:3021,http://localhost:3022,http://localhost:3023,http://localhost:3024
# Optional local comparison instance; both values required together. Only accepted
# in authenticated development mode on a loopback CLUE_APP_ORIGIN with an explicit
# port. Pins every session/BFF request to an existing authorized workspace, rejects
# workspace switching/provisioning, and isolates the workspace cookie + Next cache
# by port. Empty values preserve normal multi-workspace behavior. No auth bypass.
CLUE_LOCAL_WORKSPACE_ID=
CLUE_LOCAL_WORKSPACE_NAME=
# The server forwards Clerk's default session token (no JWT template): it carries the
# session-bound sid/azp claims the backend verifies; no audience claim participates.

# Clerk application values. Commit names/placeholders only; real values stay in .env.local or the
# deployment secret store. The publishable key is intentionally public; the secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/onboarding/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/session/establish
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/session/establish
# FI-4 slice 1 (headless Clerk behind the frozen onboarding screens) additionally requires, in
# the Clerk dashboard: bot protection DISABLED instance-wide (no CAPTCHA element is mounted),
# and email verification by CODE enabled (the in-house /onboarding/verify-email screen).
# /sign-in is a redirect into /onboarding/sign-in; no Clerk-rendered UI exists anywhere.

# --- FI Lane D D5: the projects/chat flow's own fixtures->HTTP cutover ----------------------
# Origin-RELATIVE path prefix only (normally the same-origin BFF mount below); a non-relative
# value throws at configuration so the browser can never reach FastAPI cross-origin.
# Unset => the projects/chat feature stays fixture-backed.
CLUE_PROJECTS_API_BASE_URL=/api/clue

# Design (lumen) API origin for the authenticated BFF at /api/clue/design (W1.2).
# Server-side only; the design API is workspace-header-auth and must never be
# reachable from browsers directly.
LUMEN_API_BASE_URL=http://127.0.0.1:8013
