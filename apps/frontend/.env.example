# Leave both unset to use the validated local fixture repositories.
#
# CLUE_API_BASE_URL activates the HTTP adapters against the backend read layer
# (`/frontend/v1`). It is read on the Next.js server only — never expose it as
# NEXT_PUBLIC_*, because the workspace scope below is tenancy.
CLUE_API_BASE_URL=http://127.0.0.1:8000

# Every /frontend/v1 data request is workspace-scoped through the
# X-Workspace-Id header; the backend answers 401 UNAUTHORIZED without it. This
# is the MVP stand-in for a real session/tenant surface and is required
# whenever CLUE_API_BASE_URL is set.
CLUE_WORKSPACE_ID=ws_local_dev
