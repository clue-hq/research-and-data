{
  "compilerOptions": {
    // ES2020 (was the ES2017 Next scaffold default): the scene engine extracted
    // verbatim from the design subsystem (AD1.3) uses BigInt literals in
    // `engine/scene/operations.ts` (stableHash64Hex), which tsc rejects below
    // ES2020. The upstream editor targets ES2022; ES2020 is the smallest bump
    // that keeps the extracted sources byte-identical to their origin.
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // The site kit's tests and fixtures are type-checked by its own tsconfig
  // (`npm run typecheck -w @clue/site-kit`), which maps the alias agent-written sections use
  // (@/puck/agent-kit); the app's check would follow a test's import into a fixture using it.
  "exclude": ["node_modules", "packages/site-kit/test/**/*"]
}
